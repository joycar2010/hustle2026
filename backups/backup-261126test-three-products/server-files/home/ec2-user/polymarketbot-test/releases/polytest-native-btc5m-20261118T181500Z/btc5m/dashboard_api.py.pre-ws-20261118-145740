@app.websocket("/ws")
async def dashboard_ws(websocket: WebSocket) -> None:
    """Stream the same read-only snapshot used by the dashboard.

    The browser dashboard uses this endpoint as its sole refresh path.  The
    snapshot builder performs blocking HTTP and SQLite work, so it runs in a
    worker thread to keep the ASGI event loop responsive while other clients
    connect.  A short interval is enough for quote updates without creating a
    request storm against Gamma/CLOB.
    """
    await websocket.accept()
    try:
        while True:
            snapshot = await asyncio.to_thread(state)
            await websocket.send_json(snapshot)
            await asyncio.sleep(2.0)
    except WebSocketDisconnect:
        return
    except Exception:
        # A broken client or proxy should not leave a task running forever.
        # Starlette will close the socket when the handler returns.
        return
