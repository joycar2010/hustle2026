[Unit]
Description=Polytest supervised BTC live worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/polymarketbot-test/releases/polytest-p0p1-20261110T182300Z
EnvironmentFile=/home/ec2-user/polymarketbot-test/releases/polytest-p0p1-20261110T182300Z/.env
Environment=PYTHONPATH=/home/ec2-user/polymarketbot-test/releases/polytest-p0p1-20261110T182300Z
Environment=PYTHONUNBUFFERED=1
Environment=LIVE_WORKER_SYSTEMD_UNIT=polymarket-test-btc-live.service
ExecStartPre=/home/ec2-user/polymarketbot-test/releases/polytest-p0p1-20261110T182300Z/.venv/bin/python /home/ec2-user/polymarketbot-test/releases/polytest-p0p1-20261110T182300Z/scripts/live_preflight.py
ExecStartPre=/home/ec2-user/polymarketbot-test/releases/polytest-p0p1-20261110T182300Z/.venv/bin/python /home/ec2-user/polymarketbot-test/releases/polytest-p0p1-20261110T182300Z/scripts/verify_setup.py
ExecStart=/home/ec2-user/polymarketbot-test/releases/polytest-p0p1-20261110T182300Z/.venv/bin/python -m bot.live_worker --live --asset BTC
Restart=on-failure
RestartSec=5
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polytest-btc-live

[Install]
WantedBy=multi-user.target
