[Unit]
Description=Polymarket SOL5M read-only Paper API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/poly-sol5m-release
Environment=PRODUCT_KEY=sol5m
Environment=SERIES_SLUG=sol-up-or-down-5m
Environment=MARKET_SLUG_PREFIX=sol-updown-5m
Environment=CRYPTO_ASSET=sol
Environment=LIVE=false
Environment=LIVE_TRADING_ENABLED=false
Environment=DASHBOARD_PORT=8095
ExecStart=/opt/poly-sol5m-release/.venv/bin/python -m sol5m api --port 8095
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

