[Unit]
Description=polyauto slow-loop agents (one pass)
After=network.target
[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/polymarketbot-auto
Environment=PYTHONPATH=/home/ec2-user/polymarketbot-auto
EnvironmentFile=/home/ec2-user/polymarketbot-auto/.env
ExecStart=/home/ec2-user/polymarketbot-auto/.venv/bin/python -m agents.run --db /home/ec2-user/polymarketbot-auto/trades-auto.db --limit 60
