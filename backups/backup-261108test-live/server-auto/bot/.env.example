SELL_FOK_SLIPPAGE_TICKS=1
SELL_EXIT_MAX_DEPTH_TICKS=0
SELL_EXIT_MAX_DEPTH_LEVELS=10
SELL_EXIT_FAK_FALLBACK_ENABLED=true
SELL_EXIT_RECONCILE_TRADES=true

# --- Weather ensemble strategy ---
# Weather is paper-only until both flags are deliberately enabled.
WEATHER_ENABLED=true
WEATHER_LIVE_TRADING_ENABLED=false
WEATHER_CITIES=nyc,chicago,miami,los_angeles,denver
WEATHER_SCAN_INTERVAL_SEC=300
WEATHER_MARKET_SCAN_PAGES=25
WEATHER_MIN_EDGE=0.08
WEATHER_MIN_ENTRY_PRICE=0.05
WEATHER_MAX_ENTRY_PRICE=0.70
WEATHER_MAX_ENSEMBLE_STD_F=6.0
WEATHER_ORDER_RISK_FRACTION=0.02
WEATHER_MAX_MARKETS_PER_CYCLE=5
WEATHER_FORECAST_CACHE_TTL_SEC=900
WEATHER_MAX_DAYS_AHEAD=3


# --- Created by scripts/derive_api_creds.py ---
# L2 API key derived from your private-key signature. The bot uses these to
# authenticate every order. Treat as a password.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=


# --- Created by scripts/migrate_to_deposit_wallet.py ---
# Your Polymarket V2 deposit wallet address. Differs from WALLET_ADDRESS.
# This is also where your funds live after step 4.
DEPOSIT_WALLET_ADDRESS=
