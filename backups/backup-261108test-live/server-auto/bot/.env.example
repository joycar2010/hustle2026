# =============================================================================
#  poly_hft .env reference
# =============================================================================
#
#  YOU DO NOT FILL THIS FILE IN BY HAND.
#
#  The setup scripts create and update a real `.env` for you. This file just
#  documents which variables exist and which script writes each one, so you
#  know what to expect after each step.
#
#  Standard setup, in order:
#
#    1. scripts/generate_wallet.py            -> creates .env with the keys below
#    2. (you fund the wallet on Polygon)
#    3. scripts/wrap_to_pusd.py               -> no .env changes
#    4. scripts/migrate_to_deposit_wallet.py  -> sets FUNDER_ADDRESS + SIGNATURE_TYPE + DEPOSIT_WALLET_ADDRESS
#    5. scripts/derive_api_creds.py           -> sets the three CLOB_API_* values
#
#  See README.md for the full walkthrough.
# =============================================================================


# --- Created by scripts/generate_wallet.py ---
# Your fresh trading wallet. NEVER share PRIVATE_KEY.
PRIVATE_KEY=0x<64 hex chars>
WALLET_ADDRESS=0x<your EOA address>

# Defaults to the EOA, then changed to the deposit wallet by step 4.
FUNDER_ADDRESS=0x<your EOA address>

# 0 = raw EOA (rejected by Polymarket V2)
# 3 = Polymarket V2 deposit wallet (POLY_1271) -- this is what step 4 sets
SIGNATURE_TYPE=0


# --- Network (you usually don't touch these) ---
CHAIN_ID=137
# Public RPC is fine to start. For HFT, swap in Alchemy or QuickNode.
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# --- Polymarket endpoints (you usually don't touch these) ---
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# --- Optional strategy filters ---
# LIVE Chainlink TWAP markets should use Polymarket RTDS 30s TWAP. Binance is
# available only as an explicit debug/proxy fallback via PRICE_SIGNAL_SOURCE=binance.
BTC_DELTA_FILTER_ENABLED=true
BTC_DELTA_THRESHOLD_USD=8
BTC_UP_MIN_DELTA_USD=15
BTC_UP_MAX_DELTA_USD=0
BTC_DOWN_MIN_DELTA_USD=0
BTC_DOWN_MAX_DELTA_USD=-15
BTC_PRICE_SYMBOL=BTCUSDT
BTC_PRICE_HOSTS=https://api.binance.com,https://api1.binance.com,https://api.binance.us
PRICE_SIGNAL_SOURCE=rtds
RTDS_WS_URL=wss://ws-live-data.polymarket.com
RTDS_TOPIC=crypto_prices_twap_thirty
RTDS_MAX_AGE_SEC=5
RTDS_STALE_MAX_AGE_SEC=12
RTDS_BEAT_MAX_START_LAG_SEC=5
RTDS_INITIAL_WAIT_SEC=3
RTDS_RETENTION_SEC=900
CHAINLINK_BTC_TWAP_30S_FEED_ID=0x0002e6b03af5a87b65f4c5c0c8eaf6027e4156f467cd16bdcf8a5b4347f9c087
CHAINLINK_ETH_TWAP_30S_FEED_ID=0x00020ee5ba8c3b643145974fd94552d591f2a3bb165c196ccf4c30ba600fbffd
PRICE_SOURCE_GUARD_ENABLED=true
ALLOW_BINANCE_PROXY_CHAINLINK_ENTRIES=false
ETH_MARKET_ENABLED=true
ETH_TRADING_ENABLED=false
ETH_SERIES_SLUG=eth-up-or-down-5m
ETH_PRICE_SYMBOL=ETHUSDT
ETH_DELTA_FILTER_ENABLED=true
ETH_DELTA_THRESHOLD_USD=0.50
ETH_UP_MIN_DELTA_USD=0.50
ETH_UP_MAX_DELTA_USD=0
ETH_DOWN_MIN_DELTA_USD=0
ETH_DOWN_MAX_DELTA_USD=-0.50
ETH_EARLY_STRONG_DELTA_UP_MIN_DELTA_USD=2.00
ETH_EARLY_STRONG_DELTA_DOWN_MAX_DELTA_USD=-2.00
ETH_STRONG_DELTA_UP_MIN_DELTA_USD=1.50
ETH_STRONG_DELTA_DOWN_MAX_DELTA_USD=-1.50
ETH_LATE_EDGE_DELTA_FILTER_ENABLED=false
ETH_LATE_EDGE_UP_MIN_DELTA_USD=0
ETH_LATE_EDGE_DOWN_MAX_DELTA_USD=0
ETH_LATE_EDGE_CONFIRM_CHECKS=3
ETH_EARLY_STRONG_DELTA_RISK_FRACTION=0.03
ETH_STRONG_DELTA_RISK_FRACTION=0.03
ETH_ORDER_RISK_FRACTION=0.035
ETH_LATE_EDGE_RISK_FRACTION=0.04

# --- Execution / protection tuning ---
MIN_ENTRY_PRICE=0.98
MAX_ENTRY_PRICE=0.99
UP_MIN_ENTRY_PRICE=0.98
UP_MAX_ENTRY_PRICE=0.99
MIN_NET_EDGE=0.04
HIGH_PRICE_EDGE_THRESHOLD=0
HIGH_PRICE_MIN_NET_EDGE=0.04
HIGH_PRICE_BTC_DELTA_USD=0
SECONDS_BEFORE_CLOSE=120
MIN_T_REMAINING_SEC=60
CONFIRM_CHECKS=4
ORDER_RISK_FRACTION=0.04
ORDER_FIXED_NOTIONAL_USD=0
MIN_ORDER_NOTIONAL_USD=0
MAX_DAILY_LOSS_FRACTION=0
# 0 disables the consecutive-loss lockout.
CONSECUTIVE_LOSS_KILL=3
MID_ENTRY_ENABLED=false
MID_ENTRY_WINDOW_SEC=180
MID_ENTRY_MIN_T_REMAINING_SEC=30
MID_ENTRY_MIN_PRICE=0.40
MID_ENTRY_MAX_PRICE=0.75
MID_ENTRY_CONFIRM_CHECKS=2
MID_ENTRY_RISK_FRACTION=0.03
MID_BTC_UP_MIN_DELTA_USD=15
MID_BTC_DOWN_MAX_DELTA_USD=-15
STRONG_DELTA_ENTRY_ENABLED=true
STRONG_DELTA_ENTRY_WINDOW_SEC=180
STRONG_DELTA_ENTRY_MIN_T_REMAINING_SEC=120
STRONG_DELTA_ENTRY_MIN_PRICE=0.750
STRONG_DELTA_ENTRY_MAX_PRICE=1.0
STRONG_DELTA_ENTRY_UP_MIN_DELTA_USD=50
STRONG_DELTA_ENTRY_DOWN_MAX_DELTA_USD=-50
STRONG_DELTA_ENTRY_CONFIRM_CHECKS=4
STRONG_DELTA_ENTRY_RISK_FRACTION=0.03
EARLY_STRONG_DELTA_ENTRY_ENABLED=true
EARLY_STRONG_DELTA_ENTRY_WINDOW_SEC=280
EARLY_STRONG_DELTA_ENTRY_MIN_T_REMAINING_SEC=180
EARLY_STRONG_DELTA_ENTRY_MIN_PRICE=0.650
EARLY_STRONG_DELTA_ENTRY_MAX_PRICE=1.0
EARLY_STRONG_DELTA_ENTRY_UP_MIN_DELTA_USD=68
EARLY_STRONG_DELTA_ENTRY_DOWN_MAX_DELTA_USD=-68
EARLY_STRONG_DELTA_ENTRY_CONFIRM_CHECKS=5
EARLY_STRONG_DELTA_ENTRY_RISK_FRACTION=0.02
LATE_EDGE_ENTRY_ENABLED=true
LATE_EDGE_ENTRY_WINDOW_SEC=60
LATE_EDGE_ENTRY_MIN_T_REMAINING_SEC=10
LATE_EDGE_ENTRY_MIN_PRICE=0.780
LATE_EDGE_ENTRY_MAX_PRICE=0.93
LATE_EDGE_ENTRY_DELTA_FILTER_ENABLED=false
LATE_EDGE_ENTRY_UP_MIN_DELTA_USD=10
LATE_EDGE_ENTRY_DOWN_MAX_DELTA_USD=-10
LATE_EDGE_ENTRY_CONFIRM_CHECKS=3
LATE_EDGE_ENTRY_MID_CONFIRM_CHECKS=3
LATE_EDGE_ENTRY_LATE_CONFIRM_CHECKS=2
ENTRY_MOMENTUM_FILTER_ENABLED=true
ENTRY_MOMENTUM_MIN_PRICE=0.800
ENTRY_MOMENTUM_MAX_PRICE=0.930
ENTRY_MOMENTUM_MAX_ASK_MOVE=0.030
TAIL_ENTRY_ENABLED=true
TAIL_ENTRY_WINDOW_SEC=10
TAIL_ENTRY_MIN_T_REMAINING_SEC=0
TAIL_ENTRY_MIN_PRICE=0.60
TAIL_ENTRY_MAX_PRICE=0.93
TAIL_ENTRY_CONFIRM_CHECKS=1
SCALE_IN_AFTER_EARLY_ENABLED=true
VOLATILITY_WINDOW_SEC=5
MAX_TOP_MOVE_TICKS=10
EARLY_ENTRY_ENABLED=false
# Negative disables the retry price chase guard; price zone and time window remain active.
MAX_RETRY_PRICE_DRIFT_TICKS=-1
FOK_PRICE_BUFFER_TICKS=0
MARKET_STALE_GRACE_SEC=30
REVERSAL_EXIT_ENABLED=true
REVERSAL_PARTIAL_EXIT_ENABLED=false
REVERSAL_PARTIAL_EXIT_WINDOW_SEC=60
REVERSAL_PARTIAL_EXIT_MIN_T_REMAINING_SEC=30
REVERSAL_PARTIAL_HELD_BID_DRAWDOWN=0.25
REVERSAL_PARTIAL_CONFIRM_CHECKS=2
REVERSAL_PARTIAL_EXIT_FRACTION=0.50
REVERSAL_EXIT_WINDOW_SEC=40
REVERSAL_NORMAL_MIN_T_REMAINING_SEC=10
REVERSAL_EXIT_MIN_T_REMAINING_SEC=0
REVERSAL_HELD_BID_THRESHOLD=0
REVERSAL_HELD_BID_DRAWDOWN=0.20
REVERSAL_CONFIRM_CHECKS=0
REVERSAL_EXIT_REQUIRE_BTC_REVERSAL=false
REVERSAL_LATE_EXIT_ENABLED=false
REVERSAL_LATE_WINDOW_SEC=10
REVERSAL_LATE_HELD_BID_THRESHOLD=0.60
REVERSAL_LATE_CONFIRM_CHECKS=1
