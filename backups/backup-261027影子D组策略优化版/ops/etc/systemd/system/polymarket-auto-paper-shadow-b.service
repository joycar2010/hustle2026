[Unit]
Description=polyauto Paper shadow B BTC
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/paper-ab/20261026T110000Z/B
ExecStart=/home/ec2-user/paper-ab/20261026T110000Z/B/run.sh
Restart=always
RestartSec=10
TimeoutStopSec=20
StandardOutput=append:/home/ec2-user/paper-ab/20261026T110000Z/B/run.log
StandardError=append:/home/ec2-user/paper-ab/20261026T110000Z/B/run.log
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
