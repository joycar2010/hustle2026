[Unit]
Description=Polymarket dashboard API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/polymarketbot
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/home/ec2-user/polymarketbot/.venv/bin/python -c "from bot import store; store._conn().close()"
ExecStart=/home/ec2-user/polymarketbot/.venv/bin/uvicorn server.dashboard:app --host 127.0.0.1 --port 8787 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
SyslogIdentifier=polymarket-dashboard

[Install]
WantedBy=multi-user.target
