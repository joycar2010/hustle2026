server {
    listen 80;
    server_name polyauto.hustle2026.xyz;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; default_type text/plain; }
    location ~ /\\. { deny all; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name polyauto.hustle2026.xyz;
    root /var/www/polyauto.hustle2026.xyz;
    ssl_certificate /etc/letsencrypt/live/polyauto.hustle2026.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/polyauto.hustle2026.xyz/privkey.pem;
    location ~ /\\. { deny all; }
    location /api/ { proxy_pass http://127.0.0.1:8887; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_read_timeout 30s; }
    location / { try_files $uri $uri/ /index.html; }
}
