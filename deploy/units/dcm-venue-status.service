[Unit]
Description=DexCexMix venue-status-ingest (official status pages, read-only public)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Slice=dexcexmix.slice
MemoryMax=128M
WorkingDirectory=/home/ec2-user/dexcexmix/src
EnvironmentFile=/home/ec2-user/dexcexmix/.env
ExecStart=/home/ec2-user/dexcexmix/venv/bin/python services/venue-status/app/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
