[Unit]
Description=DexCexMix account snapshot (B-only, read-only real-account reconcile feed)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Slice=dexcexmix.slice
MemoryMax=256M
WorkingDirectory=/home/ec2-user/dexcexmix/src
EnvironmentFile=/home/ec2-user/dexcexmix/.env
ExecStart=/home/ec2-user/dexcexmix/venv/bin/python services/account-snapshot/app/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
