[Unit]
Description=DexCexMix risk ledger (independent watchdog plane, alert-only)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Slice=dexcexmix.slice
MemoryMax=512M
WorkingDirectory=/home/ec2-user/dexcexmix/src
EnvironmentFile=/home/ec2-user/dexcexmix/.env
ExecStart=/home/ec2-user/dexcexmix/venv/bin/python services/risk-ledger/app/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
