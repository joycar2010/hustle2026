[Unit]
Description=DexCexMix PnL recorder (per-bill income + equity snapshots)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Slice=dexcexmix.slice
MemoryMax=256M
WorkingDirectory=/home/ec2-user/dexcexmix/src
EnvironmentFile=/home/ec2-user/dexcexmix/.env
ExecStart=/home/ec2-user/dexcexmix/venv/bin/python services/pnl-recorder/app/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
