[Unit]
Description=DexCexMix carry advisor v1 (rule-based best-pair scanner, removable)
After=network-online.target dcm-decision.service
Wants=network-online.target

[Service]
User=ec2-user
Slice=dexcexmix.slice
MemoryMax=256M
WorkingDirectory=/home/ec2-user/dexcexmix/src
EnvironmentFile=/home/ec2-user/dexcexmix/.env
ExecStart=/home/ec2-user/dexcexmix/venv/bin/python services/carry-advisor/app/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
