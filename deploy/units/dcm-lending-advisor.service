[Unit]
Description=DexCexMix lending advisor (3-rate net-diff ranking)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Slice=dexcexmix.slice
MemoryMax=256M
WorkingDirectory=/home/ec2-user/dexcexmix/src
EnvironmentFile=/home/ec2-user/dexcexmix/.env
ExecStart=/home/ec2-user/dexcexmix/venv/bin/python services/lending-advisor/app/main.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
