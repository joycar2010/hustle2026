[Unit]
Description=DexCexMix LLM advisor (read-only review layer, never touches money path)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Slice=dexcexmix.slice
MemoryMax=256M
WorkingDirectory=/home/ec2-user/dexcexmix/src
EnvironmentFile=/home/ec2-user/dexcexmix/.env
ExecStart=/home/ec2-user/dexcexmix/venv/bin/python services/llm-advisor/app/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
