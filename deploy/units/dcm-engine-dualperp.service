[Unit]
Description=DexCexMix dual-perp pairing engine (shadow mode until keys+canary)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Slice=dexcexmix.slice
MemoryMax=1G
WorkingDirectory=/home/ec2-user/dexcexmix/src
EnvironmentFile=/home/ec2-user/dexcexmix/.env
# ── CANARY 武装(2026-07-10):双门闸 armed + 单币白名单;硬顶 12U ≈ 10U 名义 ──
Environment=DCM_DP_MODE=armed
Environment=DCM_DP_ARM_SYMBOLS=LABUSDT
Environment=DCM_DP_MAX_NOTIONAL_HARD=12
ExecStart=/home/ec2-user/dexcexmix/venv/bin/python services/engine-dualperp/app/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
