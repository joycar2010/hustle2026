[Unit]
Description=DexCexMix credential agent (B机;密文解密下发,明文只在此)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Slice=dexcexmix.slice
MemoryMax=256M
WorkingDirectory=/home/ec2-user/dexcexmix/src
EnvironmentFile=/home/ec2-user/dexcexmix/.env
ExecStart=/home/ec2-user/dexcexmix/venv/bin/python services/cred-agent/app/main.py
Restart=always
RestartSec=8

[Install]
WantedBy=multi-user.target
