[Unit]
Description=DexCexMix depth sampler (±band tradable notional for active route legs)
After=network-online.target redis6.service
Wants=network-online.target

[Service]
User=ec2-user
Slice=dexcexmix.slice
MemoryMax=256M
WorkingDirectory=/home/ec2-user/dexcexmix/src
EnvironmentFile=/home/ec2-user/dexcexmix/.env
ExecStart=/home/ec2-user/dexcexmix/venv/bin/python services/depth-sampler/app/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
