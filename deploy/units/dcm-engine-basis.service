[Unit]
Description=DexCexMix basis carry engine (binance spot+perp, shadow)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Slice=dexcexmix.slice
MemoryMax=512M
WorkingDirectory=/home/ec2-user/dexcexmix/src
EnvironmentFile=/home/ec2-user/dexcexmix/.env
ExecStart=/home/ec2-user/dexcexmix/venv/bin/python services/engine-basis/app/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
