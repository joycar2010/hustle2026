[Unit]
Description=CEX-DEX spread survival measurer (read-only, no signing/no funds)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/crossarb
EnvironmentFile=-/home/ec2-user/crossarb/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/usr/bin/python3 -m app.cexdex_shadow
Restart=always
RestartSec=10
MemoryMax=256M

[Install]
WantedBy=multi-user.target
