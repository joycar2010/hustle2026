async function saveAlertSettings() {
  try {
    // 先拉最新设置（避免覆盖另一 panel 的字段），再合并当前面板的 2 个字段
    let existing = {}
    try {
      const r = await api.get('/api/v1/risk/alert-settings', {
        params: { pair_code: alertPairCode.value }
      })
      existing = r.data || {}
    } catch {}

    const merged = { ...existing, pair_code: alertPairCode.value }
    if (props.type === 'forward') {
      merged.forwardOpenPrice  = _nullable(alertSettings.value.forwardOpenPrice)
      merged.forwardClosePrice = _nullable(alertSettings.value.forwardClosePrice)
    } else {
      merged.reverseOpenPrice  = _nullable(alertSettings.value.reverseOpenPrice)
      merged.reverseClosePrice = _nullable(alertSettings.value.reverseClosePrice)
    }

    await api.post('/api/v1/risk/alert-settings', merged)
    // 通知通知系统刷新当前产品对的阈值
    notificationStore.loadAlertSettings(alertPairCode.value)
    notificationStore.showStrategyNotification(`[${alertPairCode.value}] 提醒设置保存成功`, 'success')
  } catch (error) {
    console.error('Failed to save alert settings:', error)
    notificationStore.showStrategyNotification('保存失败: ' + (error.response?.data?.detail || error.message), 'error')
  }
}

// 空字符串/undefined/NaN → null
function _nullable(v) {
  if (v === '' || v === undefined) return null
  if (typeof v === 'number' && isNaN(v)) return null
  return v
}

