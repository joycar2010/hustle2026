<Window x:Class="QhClient.PayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="支付" Height="440" Width="440"
        WindowStartupLocation="CenterOwner" Background="#0B1220">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#9FB0D6"/><Setter Property="FontSize" Value="12"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111A2E"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#243256"/><Setter Property="Padding" Value="6,5"/></Style>
  </Window.Resources>
  <StackPanel Margin="22">
    <TextBlock x:Name="TitleTxt" Text="支付" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

    <!-- 充值金额(recharge) -->
    <StackPanel x:Name="AmountBox" Visibility="Collapsed" Margin="0,0,0,10">
      <TextBlock Text="充值金额 (USDT)"/>
      <TextBox x:Name="AmountInput" Text="200" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- 支付方式 -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <RadioButton x:Name="PmOnchain" Content="链上支付 (TRC20)" IsChecked="True" Foreground="#C9D6E8" Margin="0,0,16,0" Checked="Pm_Changed"/>
      <RadioButton x:Name="PmBalance" Content="余额支付" Foreground="#C9D6E8" Checked="Pm_Changed"/>
    </StackPanel>

    <Border Background="#111A2E" CornerRadius="8" Padding="12" Margin="0,0,0,10">
      <StackPanel>
        <Grid Margin="0,0,0,4"><TextBlock Text="应付金额"/><TextBlock x:Name="AmtLabel" Text="--" HorizontalAlignment="Right" Foreground="White" FontWeight="Bold"/></Grid>
        <Grid><TextBlock x:Name="ExtraK" Text="商品"/><TextBlock x:Name="ExtraV" Text="--" HorizontalAlignment="Right" Foreground="White"/></Grid>
      </StackPanel>
    </Border>

    <!-- 链上: 地址+哈希 -->
    <StackPanel x:Name="OnchainBox">
      <TextBlock Text="TRC20 收款地址(转账后粘贴哈希)"/>
      <Border Background="#111A2E" CornerRadius="6" Padding="8" Margin="0,4,0,8">
        <TextBlock x:Name="AddrTxt" Text="加载中…" Foreground="#2E8BD6" FontSize="12" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="转账哈希 TxID"/>
      <TextBox x:Name="HashInput" Margin="0,4,0,0"/>
    </StackPanel>
    <!-- 余额 -->
    <TextBlock x:Name="BalanceHint" Visibility="Collapsed" Foreground="#8FE0AA" FontSize="12" TextWrapping="Wrap"/>

    <TextBlock x:Name="Msg" Foreground="#F26D6D" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="取消" Click="Cancel_Click" Padding="14,6" Margin="0,0,8,0" Background="#243256" Foreground="#C9D6E8" BorderThickness="0" Cursor="Hand"/>
      <Button x:Name="SubmitBtn" Content="确认支付" Click="Submit_Click" Padding="18,6" Background="#2E8BD6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
    </StackPanel>
  </StackPanel>
</Window>
