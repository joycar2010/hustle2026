<?xml version="1.0" encoding="utf-8"?>
<!--
  Quant Hedge 客户端 ConfuserEx2 安全配置
  原则: 只护自家 QuantHedge.dll; 只开对 WPF/WebView2/MVVM 安全的保护档; 关一切会崩绑定/资源/反射的项。
  开: constants(字符串加密) + ctrl flow(控制流) + anti debug + anti dump + anti ildasm
  关: rename(破 XAML BAML 绑定/MVVM 源生成) + resources(破内嵌资源按名查找) + anti tamper(改IL, WPF模块化加载有崩风险)
-->
<project outputDir="C:\Users\Administrator\qh_client\publish_fld_obf" baseDir="C:\Users\Administrator\qh_client\publish_fld" xmlns="http://confuser.codeplex.com">
  <!-- 全局规则: 默认给所有成员挂一个"安全档"预设, 但不含 rename -->
  <rule pattern="true" preset="none" inherit="false">
    <protection id="anti ildasm" />
    <protection id="anti dump" />
    <protection id="anti debug" />
    <protection id="constants" />
    <protection id="ctrl flow" />
  </rule>

  <!-- 只对本模块生效; 第三方 DLL 只作引用不混淆 -->
  <module path="QuantHedge.dll" />
</project>
