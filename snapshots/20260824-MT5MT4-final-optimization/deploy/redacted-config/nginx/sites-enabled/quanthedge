server {
    server_name qh.hustle2026.xyz;
    include /etc/nginx/snippets/qh-security-headers.conf;

    location /api/ {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://127.0.0.1:9091;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    root /opt/quanthedge/web;
    index index.html;
    # å£³ HTML/SW ç¦å¯å‘å¼ç¼“å­˜(å¸¦ ETag èµ° 304): å‘å¸ƒå³ç”Ÿæ•ˆ, é˜²æ—§å£³ç¼“å­˜åžæŽ‰éƒ¨ç½²
    location = /index.html {
        include /etc/nginx/snippets/qh-security-headers.conf;
        add_header Cache-Control "no-cache";
    }
    location = /sw.js {
        include /etc/nginx/snippets/qh-security-headers.conf;
        add_header Cache-Control "no-cache";
    }
    location / { try_files $uri $uri/ /index.html; }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/qh.hustle2026.xyz/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/qh.hustle2026.xyz/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = qh.hustle2026.xyz) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name qh.hustle2026.xyz;
    return 404; # managed by Certbot


}

