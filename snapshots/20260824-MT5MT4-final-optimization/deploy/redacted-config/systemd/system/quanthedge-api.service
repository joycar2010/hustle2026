[Unit]
Description=Quant Hedge API
After=network.target postgresql.service redis-server.service

[Service]
User=ubuntu
WorkingDirectory=/opt/quanthedge
Environment=<REDACTED>
ExecStart=/opt/quanthedge/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8090 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

