<Window x:Class="QhClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Quant Hedge 交易终端" Height="760" Width="1040"
        WindowStartupLocation="CenterScreen" Background="#0B1220">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#111A2E"/>
      <Setter Property="BorderBrush" Value="#1E2A44"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock"><Setter Property="Foreground" Value="#7C8B9E"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Val" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="Transparent"/><Setter Property="Foreground" Value="#C9D6E8"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#1A2540"/>
      <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="RowHeight" Value="26"/><Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 顶栏 -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="QUANT HEDGE" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
          <TextBlock Text="交易终端" FontSize="13" Foreground="#2E8BD6" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Border Background="#0F2A1A" CornerRadius="4" Padding="8,3" Margin="0,0,10,0"
                  Visibility="{Binding Demo, Converter={StaticResource BoolVis}}">
            <TextBlock Text="演示模式" Foreground="#FFD08A" FontSize="12"/>
          </Border>
          <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0"
                   Fill="{Binding Connected, Converter={StaticResource ConnColor}}"/>
          <TextBlock Text="{Binding ConnStatus}" FontSize="12" Foreground="#9FB0D6" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <TextBlock Text="{Binding Username}" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Plan, StringFormat=' · {0}'}" FontSize="12" Foreground="#9FB0D6" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Expire, StringFormat=' · 到期 {0}'}" FontSize="12" Foreground="#9FB0D6" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button Content="参数" Click="Config_Click" Padding="10,4" Margin="0,0,6,0" Background="#243256" Foreground="#C9D6E8" BorderThickness="0" Cursor="Hand"/>
          <Button Content="内购" Click="Store_Click" Padding="10,4" Margin="0,0,6,0" Background="#F26D21" Foreground="White" BorderThickness="0" Cursor="Hand"/>
          <Button Content="🤖 AI套利" Click="Arb_Click" Padding="10,4" Margin="0,0,6,0" Background="#6A3DF0" Foreground="White" BorderThickness="0" Cursor="Hand"/>
          <Button Content="退出" Click="Logout_Click" Padding="10,4" Background="#243256" Foreground="#C9D6E8" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 综合条 -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"><TextBlock Text="综合浮动盈亏" Style="{StaticResource Lbl}"/>
          <TextBlock Text="{Binding TotalProfit, StringFormat='0.00'}" FontSize="20" FontWeight="Bold"
                     Foreground="{Binding TotalProfit, Converter={StaticResource PnlColor}}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="反向点差(对冲Ask−主Bid)" Style="{StaticResource Lbl}"/>
          <TextBlock Text="{Binding RevSpread, StringFormat='0.00'}" Style="{StaticResource Val}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="正向点差(主Ask−对冲Bid)" Style="{StaticResource Lbl}"/>
          <TextBlock Text="{Binding FwdSpread, StringFormat='0.00'}" Style="{StaticResource Val}"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="引擎 / 单量" Style="{StaticResource Lbl}"/>
          <TextBlock Style="{StaticResource Val}"><Run Text="{Binding MarketState}"/><Run Text=" · "/><Run Text="{Binding PairCount}"/><Run Text=" 对"/></TextBlock></StackPanel>
      </Grid>
    </Border>

    <!-- 自动进出场控制 -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="自动进场" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="AeMode" Width="90" Height="26"><ComboBoxItem Content="off"/><ComboBoxItem Content="shadow"/><ComboBoxItem Content="armed"/><ComboBoxItem Content="full"/></ComboBox>
        <ComboBox x:Name="AeDir" Width="90" Height="26" Margin="6,0,0,0"><ComboBoxItem Content="reverse"/><ComboBoxItem Content="forward"/></ComboBox>
        <Button Content="应用" Click="ApplyEntry_Click" Padding="12,3" Margin="6,0,4,0" Background="#2E8BD6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        <TextBlock Text="{Binding AutoEntry, StringFormat='当前: {0}'}" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,24,0"/>

        <TextBlock Text="自动出场" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="AxMode" Width="90" Height="26"><ComboBoxItem Content="off"/><ComboBoxItem Content="shadow"/><ComboBoxItem Content="armed"/><ComboBoxItem Content="full"/></ComboBox>
        <CheckBox x:Name="AxProfitFirst" Content="盈利优先" Foreground="#9FB0D6" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <Button Content="应用" Click="ApplyExit_Click" Padding="12,3" Margin="6,0,4,0" Background="#2E8BD6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        <TextBlock Text="{Binding AutoExit, StringFormat='当前: {0}'}" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- 双腿账户卡 -->
    <Grid Grid.Row="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ContentControl Grid.Column="0" Content="{Binding Main}" ContentTemplate="{StaticResource LegCardTpl}"/>
      <ContentControl Grid.Column="2" Content="{Binding Hedge}" ContentTemplate="{StaticResource LegCardTpl}"/>
    </Grid>

    <!-- 点差图 + 历史 Tab -->
    <Border Grid.Row="4" Style="{StaticResource Card}">
      <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="点差走势">
          <sp:WpfPlot x:Name="SpreadPlot" Margin="0,8,0,0"/>
        </TabItem>
        <TabItem Header="配对成交历史">
          <DataGrid ItemsSource="{Binding Pairs}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="130"/>
              <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="70"/>
              <DataGridTextColumn Header="点差" Binding="{Binding Spread}" Width="90"/>
              <DataGridTextColumn Header="盈亏" Binding="{Binding Profit}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="主账户成交">
          <DataGrid ItemsSource="{Binding MainDeals}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="130"/>
              <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="70"/>
              <DataGridTextColumn Header="手数" Binding="{Binding Lots}" Width="80"/>
              <DataGridTextColumn Header="价格" Binding="{Binding Price}" Width="100"/>
              <DataGridTextColumn Header="盈亏" Binding="{Binding Profit}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="对冲账户成交">
          <DataGrid ItemsSource="{Binding HedgeDeals}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="130"/>
              <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="70"/>
              <DataGridTextColumn Header="手数" Binding="{Binding Lots}" Width="80"/>
              <DataGridTextColumn Header="价格" Binding="{Binding Price}" Width="100"/>
              <DataGridTextColumn Header="盈亏" Binding="{Binding Profit}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
      </TabControl>
    </Border>
  </Grid>
</Window>
