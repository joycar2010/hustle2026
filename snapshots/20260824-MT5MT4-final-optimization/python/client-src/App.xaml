<Application x:Class="QhClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QhClient">
  <Application.Resources>
    <local:PnlColorConverter x:Key="PnlColor"/>
    <local:BoolToVisConverter x:Key="BoolVis"/>
    <local:ConnColorConverter x:Key="ConnColor"/>

    <!-- 双腿账户卡模板 -->
    <DataTemplate x:Key="LegCardTpl">
      <Border Background="#111A2E" BorderBrush="#1E2A44" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="White"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0"
                       Fill="{Binding Connected, Converter={StaticResource ConnColor}}"/>
              <TextBlock Text="{Binding Conn}" FontSize="12" Foreground="#9FB0D6" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10"><TextBlock Text="平台/登录号" Foreground="#7C8B9E" FontSize="11"/>
              <TextBlock FontSize="14" Foreground="White"><Run Text="{Binding Platform}"/><Run Text=" · "/><Run Text="{Binding Login}"/></TextBlock></StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"><TextBlock Text="服务器" Foreground="#7C8B9E" FontSize="11"/>
              <TextBlock Text="{Binding Server}" FontSize="14" Foreground="White"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10"><TextBlock Text="余额" Foreground="#7C8B9E" FontSize="11"/>
              <TextBlock Text="{Binding Balance}" FontSize="16" FontWeight="SemiBold" Foreground="White"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"><TextBlock Text="净值" Foreground="#7C8B9E" FontSize="11"/>
              <TextBlock Text="{Binding Equity}" FontSize="16" FontWeight="SemiBold" Foreground="White"/></StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10"><TextBlock Text="浮动盈亏" Foreground="#7C8B9E" FontSize="11"/>
              <TextBlock Text="{Binding Pnl, StringFormat='0.00'}" FontSize="16" FontWeight="Bold"
                         Foreground="{Binding Pnl, Converter={StaticResource PnlColor}}"/></StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"><TextBlock Text="实时报价 (Ask / Bid)" Foreground="#7C8B9E" FontSize="11"/>
              <TextBlock FontSize="14" Foreground="#2E8BD6"><Run Text="{Binding Ask}"/><Run Text=" / "/><Run Text="{Binding Bid}"/></TextBlock></StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Application.Resources>
</Application>
