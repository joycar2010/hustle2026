<Window x:Class="QhClient.ArbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 套利分析" Height="560" Width="720"
        WindowStartupLocation="CenterOwner" Background="#0B1220">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="🤖 AI 套利分析" FontSize="18" FontWeight="Bold" Foreground="#A855F7" VerticalAlignment="Center"/>
        <TextBlock Text="主账户 × 对冲账户 全产品对" FontSize="12" Foreground="#7C8B9E" VerticalAlignment="Center" Margin="10,0,0,0"/>
      </StackPanel>
      <Button Content="刷新分析" Click="Refresh_Click" HorizontalAlignment="Right" Padding="14,5" Background="#6A3DF0" Foreground="White" BorderThickness="0" Cursor="Hand"/>
    </Grid>

    <!-- 未解锁提示 -->
    <Border x:Name="LockedBox" Grid.Row="1" Visibility="Collapsed" Background="#1A1330" CornerRadius="8" Padding="20" Margin="0,0,0,12">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="AI 套利分析为最高阶内购功能" FontSize="15" FontWeight="Bold" Foreground="#A855F7" HorizontalAlignment="Center"/>
        <TextBlock Text="解锁后可对主+对冲旗下全部产品对做实时可套利性分析。199 USDT/月。" FontSize="12" Foreground="#9FB0D6" Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- 汇总 -->
    <Border x:Name="SummaryBox" Grid.Row="1" Background="#1A1330" CornerRadius="8" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock x:Name="Verdict" FontSize="15" FontWeight="Bold" Foreground="#A855F7"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock x:Name="SumPairs" Foreground="#C9D6E8" FontSize="12" Margin="0,0,20,0"/>
          <TextBlock x:Name="SumReach" Foreground="#3FD07F" FontSize="12" Margin="0,0,20,0"/>
          <TextBlock x:Name="SumTop" Foreground="#C9D6E8" FontSize="12"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="Pairs">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#111A2E" BorderBrush="#1E2A44" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
              <StackPanel>
                <Grid>
                  <TextBlock FontWeight="Bold" Foreground="White"><Run Text="{Binding MainSym}"/><Run Text=" ↔ "/><Run Text="{Binding HedgeSym}"/></TextBlock>
                  <TextBlock HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{Binding ScoreColor}"><Run Text="{Binding Score}"/><Run Text="/100" FontSize="10"/></TextBlock>
                </Grid>
                <TextBlock FontSize="12" Foreground="#9FB0D6" Margin="0,4,0,0">
                  <Run Text="主 "/><Run Text="{Binding MainPrice}"/><Run Text=" · 对冲 "/><Run Text="{Binding HedgePrice}"/><Run Text=" · 基差 "/><Run Text="{Binding Basis}" Foreground="White"/><Run Text=" / 阈值 "/><Run Text="{Binding Entry}"/>
                </TextBlock>
                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Score}" Margin="0,6,0,0" Foreground="{Binding ScoreColor}" Background="#1A2540" BorderThickness="0"/>
                <TextBlock Text="{Binding Suggest}" FontSize="12" Foreground="{Binding ScoreColor}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Window>
