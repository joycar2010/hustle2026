<Window x:Class="QhClient.StoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内购商店" Height="560" Width="640"
        WindowStartupLocation="CenterOwner" Background="#0B1220">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#C9D6E8"/></Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="内购商店" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="账户余额" Foreground="#7C8B9E" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock x:Name="BalTxt" Text="--" FontSize="16" FontWeight="Bold" Foreground="#3FD07F" VerticalAlignment="Center"/>
        <TextBlock Text=" USDT" Foreground="#7C8B9E" FontSize="12" VerticalAlignment="Center"/>
        <Button Content="充值" Click="Recharge_Click" Padding="12,4" Margin="14,0,0,0" Background="#2E8BD6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="Products">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="190" Margin="0,0,12,12" CornerRadius="10" Padding="14"
                    Background="#F26D21">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background">
                    <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF9D2F" Offset="0"/><GradientStop Color="#F26D21" Offset="1"/></LinearGradientBrush></Setter.Value>
                  </Setter>
                </Style>
              </Border.Style>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="White"/>
                <TextBlock Text="{Binding Descr}" FontSize="11" Foreground="#FFF3E8" TextWrapping="Wrap" MinHeight="32" Margin="0,6,0,0"/>
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,6,0,0">
                  <Run Text="{Binding Price}"/><Run Text=" "/><Run Text="{Binding Unit}" FontSize="11"/><Run Text=" /"/><Run Text="{Binding Dur}" FontSize="11"/>
                </TextBlock>
                <Button Content="购买" Margin="0,10,0,0" Padding="0,7" Background="White" Foreground="#E2611C" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Tag="{Binding Key}" Click="Buy_Click"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Window>
