<Window x:Class="QhClient.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对冲参数配置" Height="560" Width="560"
        WindowStartupLocation="CenterOwner" Background="#0B1220">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#9FB0D6"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111A2E"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#243256"/><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Height" Value="26"/></Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="对冲参数配置" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="品种 Symbol"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="Symbol"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="对冲品种"/><TextBox Grid.Row="0" Grid.Column="4" x:Name="HedgeSymbol"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="入场点差"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="EntrySpread"/>
        <TextBlock Grid.Row="1" Grid.Column="3" Text="止盈点数"/><TextBox Grid.Row="1" Grid.Column="4" x:Name="TpPoints"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="止损点数"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="SlPoints"/>
        <TextBlock Grid.Row="2" Grid.Column="3" Text="阶梯坑数"/><TextBox Grid.Row="2" Grid.Column="4" x:Name="Ladders"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="持仓秒数"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="HoldSecs"/>
        <TextBlock Grid.Row="3" Grid.Column="3" Text="进单间隔秒"/><TextBox Grid.Row="3" Grid.Column="4" x:Name="EntryInterval"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="主腿手数倍率"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="MainLotMult"/>
        <TextBlock Grid.Row="4" Grid.Column="3" Text="对冲手数倍率"/><TextBox Grid.Row="4" Grid.Column="4" x:Name="HedgeLotMult"/>
        <TextBlock Grid.Row="5" Grid.Column="0" Text="主点差上限"/><TextBox Grid.Row="5" Grid.Column="1" x:Name="MainSpreadCap"/>
        <TextBlock Grid.Row="5" Grid.Column="3" Text="对冲点差上限"/><TextBox Grid.Row="5" Grid.Column="4" x:Name="HedgeSpreadCap"/>
        <TextBlock Grid.Row="6" Grid.Column="0" Text="滑点容差"/><TextBox Grid.Row="6" Grid.Column="1" x:Name="SlippageTol"/>
        <TextBlock Grid.Row="6" Grid.Column="3" Text="最大在途"/><TextBox Grid.Row="6" Grid.Column="4" x:Name="MaxInflight"/>
        <TextBlock Grid.Row="7" Grid.Column="0" Text="周末护栏"/>
        <CheckBox Grid.Row="7" Grid.Column="1" x:Name="WeekendGuard" Content="启用" Foreground="#9FB0D6" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="7" Grid.Column="3" Text="单腿告警"/>
        <CheckBox Grid.Row="7" Grid.Column="4" x:Name="SingleLegAlert" Content="启用" Foreground="#9FB0D6" VerticalAlignment="Center"/>
      </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <TextBlock x:Name="Msg" Foreground="#FFD08A" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Button Content="取消" Click="Cancel_Click" Padding="14,6" Margin="0,0,8,0" Background="#243256" Foreground="#C9D6E8" BorderThickness="0" Cursor="Hand"/>
      <Button Content="保存(引擎热重载)" Click="Save_Click" Padding="16,6" Background="#2E8BD6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
    </StackPanel>
  </Grid>
</Window>
