[Unit]
Description=CEX Business API (Python Canary)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/coin-project/python-business
EnvironmentFile=/etc/cex/business.env
ExecStart=/home/ec2-user/cex-venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
