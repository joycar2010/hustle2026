[Unit]
Description=CEX Arbitrage Engine (Market Data & Orchestrator)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/coin-project/python-business
EnvironmentFile=/etc/cex/business.env
ExecStart=/home/ec2-user/cex-venv/bin/python -m engine
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=30
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
