[Unit]
Description=CEX Trading Engine (Rust Canary)
After=network-online.target redis6.service
Wants=network-online.target redis6.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/coin-project/rust-engine
EnvironmentFile=/etc/cex/rust.env
ExecStart=/home/ec2-user/coin-project/rust-engine/target/release/cex-engine
Restart=always
RestartSec=3
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
