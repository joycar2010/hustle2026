    });
    b.scrollTop=b.scrollHeight; __qwCnt();
  }
  function qwPush(who,txt){ __qwMsgs.push({id:'m'+Date.now()+Math.random().toString(36).slice(2,5),who:who,txt:txt}); __qwSave(); qwRender(); }
  function qwDel(id){ __qwMsgs=__qwMsgs.filter(function(m){return m.id!==id;}); __qwSave(); qwRender(); }
  function qwClear(){ if(!__qwMsgs.length)return; if(!confirm('确定清空所有对话记录？此操作不可撤销。'))return; __qwMsgs=[]; __qwId=null; try{localStorage.removeItem('qw_conv_id');}catch(e){} __qwSave(); qwRender(); }
  async function qwSend(){ var i=document.getElementById('qw-in'); var t=(i.value||'').trim(); if(!t)return; i.value=''; qwPush('me',t);
    try{ var r=await fetch('/api/ai/chat',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({site:'qhwww',conversation_id:__qwId,message:t,user_id:'web'})});
      var j=await r.json(); if(j.conversation_id){__qwId=j.conversation_id;__qwSave();}
      qwPush('ai', j.reply||j.detail||'客服稍后联系您，如需快速对接请留下微信/手机。'); }
    catch(e){ qwPush('ai','网络繁忙，请稍后重试'); } }
</script>
