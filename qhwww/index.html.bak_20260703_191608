  .modal-head .x{background:none;border:none;color:rgba(255,255,255,.7);font-size:26px;cursor:pointer;line-height:1}
  .modal-head .x:hover{color:#fff}
  .modal-body{padding:24px 26px;overflow-y:auto;font-size:13.5px;color:var(--txt-2);line-height:1.95}
  .modal-body .lead{color:var(--txt-2);margin-bottom:6px}
  .modal-body h4{color:var(--txt);font-size:15px;margin:20px 0 6px}
  .modal-body p{margin-bottom:7px}
  .modal-body .warn{color:var(--red)}
  .modal-foot{padding:16px 22px;border-top:1px solid var(--line);text-align:right}

  @media (max-width:900px){
    .g4{grid-template-columns:repeat(2,1fr)}
    .g3{grid-template-columns:repeat(2,1fr)}
    .ai{grid-template-columns:1fr;padding:28px}
    .hero h1{font-size:34px}
    .nav-links{display:none}
    .nav-links.open{display:flex;flex-direction:column;align-items:flex-start;position:fixed;top:62px;left:0;right:0;background:var(--bg-1);border-bottom:1px solid var(--line);padding:16px 22px;gap:18px;z-index:39;box-shadow:0 12px 24px rgba(8,17,58,.14)}
    .burger{display:block}
  }
  @media (max-width:600px){
    .g4,.g3,.g2,.plans,.devices{grid-template-columns:1fr}
    .hero{padding:56px 0 46px}
    .hero h1{font-size:28px}
    .sec-head h2{font-size:25px}
    section{padding:48px 0}
  }
</style>
</head>
