# QH production backup branch.
# Keep all production source and exact frontend artifacts unless explicitly
# excluded below. Runtime secrets and plaintext databases must never be staged.

# Local and build-only directories
**/.git/
**/.staging/
**/__pycache__/
**/.pytest_cache/
**/node_modules/
**/venv/
**/.venv/
qh_ws_hub/target/
backend/geoip/
client-src/bin/
client-src/obj/
client-src/publish/
client-src/.vs/

# Editor and operating-system noise
**/.DS_Store
**/Thumbs.db
**/*.pyc
**/*.pyo
**/*.swp
**/*.tmp

# Secrets and private keys. Keep narrow exact rules so legitimate source names
# containing words such as "secret" are not silently dropped.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
channels.json
**/channels.json
*.pem
**/*.pem
*.key
**/*.key
id_rsa*
**/id_rsa*
*apikey*.txt
**/*apikey*.txt
*credential*.json
**/*credential*.json

# Plaintext databases and database exports. Only encrypted *.cms artifacts
# under backups/ are permitted in this public repository.
**/*.dump
**/*.sql
**/*.sql.gz
**/*.rdb
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.bak
**/*.backup

# Historical backend backup files are excluded from the canonical expanded
# source snapshot. Frontend deployment directories are intentionally not
# filtered: every live file, including server-side *.bak_* files, is preserved.
backend/backup_*
backend/*.bak*
qh_ws_hub/**/*.bak*

# This is a source schema, not a production database export.
!goview/src/goview-mysql.sql
