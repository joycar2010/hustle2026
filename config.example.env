# CrossArb P0 配置样例 —— 拷成 .env 后由 app/config.py 读取
# 命名空间约定:所有变量以 CROSSARB_ 开头,与生产 CEX_ 前缀零交集

# ---- 链上(Base) ----
# 多市场强烈建议用 Alchemy/QuickNode:公共 mainnet.base.org 并发限频会丢采样。
CROSSARB_BASE_RPC=https://mainnet.base.org
# CROSSARB_BASE_RPC=https://base-mainnet.g.alchemy.com/v2/<KEY>
# 并行报价并发度:公共 RPC 用 1-2,Alchemy 可 8+
CROSSARB_RPC_CONCURRENCY=2

# ---- 标的与规模 ----
# 监控的市场集在 app/markets.py(默认 BASE:ETH/BTC/VIRTUAL,已链上核实);
# 加标的不改代码:在项目根放 markets.json(数组,字段同 Market)覆盖默认集。
CROSSARB_NOTIONAL_USD=2500       # 单笔验证名义额(规格 2000-3000),可被 Market.notional_usd 覆盖

# ---- 成本假设(bps = 万分之一) ----
CROSSARB_TAKER_FEE_BPS=4.5       # 币安合约单边 taker 费(VIP0 约 0.045%);往返自动×2
CROSSARB_GAS_UNITS=150000        # 一次 V3 swap 估算 L2 gas 单位
CROSSARB_L1_FEE_USD=0.05         # L1 data 费【回退】缓冲;正常用 GasPriceOracle 实时值,仅 oracle 失败时用此
CROSSARB_RECYCLE_BPS=0           # 资金回收(桥/提币)摊销成本,默认不计;想要全负载净值时调高
CROSSARB_EXIT_FLOOR_BPS=5        # 退出滑点下限:深币聚合器常报~0,设一档池费下限避免 net 偏乐观

# ---- 机会阈值 ----
CROSSARB_MIN_NET_BPS=20          # 净基差 > 0.2% 记为一次机会

# ---- 只读币安行情(公共端点,无需 key) ----
CROSSARB_BINANCE_FAPI=https://fapi.binance.com
# 实盘/测试网做空腿才需要 key;P0 只读行情用不到

# ---- 采集/落盘/看板 ----
CROSSARB_POLL_SEC=5
CROSSARB_CSV=./data/ticks.csv
CROSSARB_HTTP_HOST=127.0.0.1     # nginx 在前,默认只听本机;本机直连调试设 0.0.0.0
CROSSARB_HTTP_PORT=8100

# ===== P1 执行验证(最小, OP单链$500). 默认 dry-run 绝不碰真金 =====
CROSSARB_EXEC_MODE=dry-run            # dry-run(默认只看价) | testnet(币安测试网真做空) | live(真金!)
CROSSARB_EXEC_MARKET=OP:BTC          # 只做这一个市场
CROSSARB_EXEC_NOTIONAL_USD=500
CROSSARB_EXEC_MIN_NET_BPS=25         # 触发执行的净基差(高于看板20留安全垫)
CROSSARB_EXEC_POLL_SEC=3
# 币安做空腿凭证 —— 必须【独立账户】, 绝不用生产 coin 账户/IP! testnet 用测试网 key
CROSSARB_BN_API_KEY=
CROSSARB_BN_API_SECRET=
# 熔断
CROSSARB_EXEC_MAX_TRADES=20
CROSSARB_EXEC_MAX_DAILY_USD=3000
CROSSARB_EXEC_NAKED_TIMEOUT_SEC=20
# 链上签名(live才需): KMS key + 钱包地址
CROSSARB_EXEC_KMS_KEY_ID=
CROSSARB_EXEC_WALLET_ADDR=

# ---- 飞书每日播报(自建应用;留空则不发) ----
CROSSARB_FEISHU_APP_ID=
CROSSARB_FEISHU_APP_SECRET=
# 收件人二选一:优先 EMAIL(与应用无关,推荐);OPEN_ID 须与本应用同源
CROSSARB_FEISHU_EMAIL=
CROSSARB_FEISHU_OPEN_ID=

# ---- 可选:crossarb:* 命名空间发布(留空则跳过,smoke 不依赖 Redis) ----
CROSSARB_REDIS_URL=
# 测试机上启用示例(本机独立 Redis):
# CROSSARB_REDIS_URL=redis://:<pass>@127.0.0.1:6379/0
