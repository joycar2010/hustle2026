(function(){
  let lpTimer=null, lpStartX=0, lpStartY=0, lpFired=false;
  function routeMenu(target,x,y){
    if(target.closest('.mask')||target.closest('.ctxmenu')||target.closest('#login'))return;
    if(target.closest('.tablecard') && (target.closest('thead')||target.closest('.ledger-hd'))){ showAt(ctxBatch,x,y); }  // 账本头/点差条(移动端长按)→批量设置
