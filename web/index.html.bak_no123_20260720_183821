  .um-auto{display:flex;align-items:center;gap:6px;margin-top:8px;font-size:11px;color:rgba(255,255,255,.9)}
  .um-auto-dot{width:7px;height:7px;border-radius:50%;background:#8a93a8;flex:0 0 auto}
