    body.mobile-mode.acct-open .accounts .accard{flex:1 1 50%;width:auto!important;height:auto!important;min-width:0;max-height:76vh;overflow:hidden}
    body.mobile-mode.acct-open::after{content:"";position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:615}
