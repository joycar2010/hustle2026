    const o={staff:q.get('staff')||'', inviter:q.get('inviter')||'', agent:q.get('agent')||''};
    // 存 localStorage(用户可能先浏览再注册, 保留归因)
    ['staff','inviter','agent'].forEach(k=>{ if(o[k]) localStorage.setItem('qh_attr_'+k,o[k]); });
    return { staff:o.staff||localStorage.getItem('qh_attr_staff')||'',
             inviter:o.inviter||localStorage.getItem('qh_attr_inviter')||'',
             agent:o.agent||localStorage.getItem('qh_attr_agent')||'' };
  }catch(e){ return {staff:'',inviter:'',agent:''}; }
}
