function drawKline(){
  if(!klCtx)return;
  const dpr=window.devicePixelRatio||1;
  const w=klCanvas.clientWidth, h=klCanvas.clientHeight;
  if(klCanvas.width!==w*dpr||klCanvas.height!==h*dpr){ klCanvas.width=w*dpr; klCanvas.height=h*dpr; }
