function renderPairedFull(r){
  const tb=$('hist-body'); if(!tb)return; const pairs=(r&&r.pairs)||[];
  // 顶栏汇总
  const s=r&&r.summary||{};
  const setn=function(id,v,money){const e=$(id);if(!e)return;e.textContent=(v==null?'--':(money?((v>=0?'+':'')+Number(v).toFixed(2)):v));if(money)e.className='num '+(v>=0?'up':'down');};
  setn('ph-cnt',s.pairs); setn('ph-net',s.net_profit,true); setn('ph-win',s.win_rate!=null?s.win_rate+'%':'--');
  setn('ph-feem',s.fee_main,true); setn('ph-feeh',s.fee_hedge,true);
  const sw=$('ph-swap'); if(sw)sw.textContent=(s.swap_main!=null?(s.swap_main+' / '+s.swap_hedge):'--');
  // 时间窗前端过滤(后端按 days 拉, 这里按起止精确裁)
  let st=null,et=null; try{ st=$('ph-start').value?new Date($('ph-start').value).getTime()/1000:null; et=$('ph-end').value?new Date($('ph-end').value).getTime()/1000:null; }catch(_){}
  const rows=pairs.filter(function(p){ const t=p.time||0; return (!st||t>=st)&&(!et||t<=et); });
  const sd=function(s){return {buy:'买',sell:'卖'}[s]||(s||'-');};
  const num=function(v,d){return v==null?'—':Number(v).toFixed(d==null?2:d);};
  const trs=rows.map(function(p){
    const t=p.time?new Date((p.time+28800)*1000):null; const ts=t?(t.getUTCFullYear()+'-'+('0'+(t.getUTCMonth()+1)).slice(-2)+'-'+('0'+t.getUTCDate()).slice(-2)+' '+('0'+t.getUTCHours()).slice(-2)+':'+('0'+t.getUTCMinutes()).slice(-2)+':'+('0'+t.getUTCSeconds()).slice(-2)):'--';  /* 北京 */
    const pf=Number(p.pair_profit||0);
    const src=p.source==='QH'?'<span style="color:var(--teal-deep)">策略</span>':'<span style="color:#8aa0a8">手动</span>';
    const mt=p.matched?'':' <span title="未配到对冲腿" style="color:#e0683a">⚠</span>';
    // 带符号执行滑点: 正=成交比决策报价更优(绿)/负=更差(红); null=无决策快照('—'); approx=以当前阈值近似(≈)
    let slipTxt,slipCls,slipTitle;
    if(p.slippage==null){ slipTxt='—'; slipCls=''; slipTitle='无决策快照(改造上线前的历史单/平仓侧无匹配快照)，不再拿开仓阈值硬套'; }
    else { slipCls=(p.slippage>0?'up':(p.slippage<0?'down':'')); slipTxt=(p.slip_src==='approx'?'≈':'')+(p.slippage>0?'+':'')+Number(p.slippage).toFixed(2);
      slipTitle=(p.slip_src==='snap'?'执行滑点=实际成交捕获点差−决策时刻报价(同成交方向)；正=成交更优, 负=成交更差(延迟/挂撤成本)':'近似:该笔无决策快照, 暂以当前配置阈值为基准'); }
    // 达标差 = 点差 − 阈值(旧HED口径, 双列并存)
    let devTxt,devCls;
    if(p.dev==null){ devTxt='—'; devCls=''; }
    else { devCls=(p.dev>0?'up':(p.dev<0?'down':'')); devTxt=(p.dev>0?'+':'')+Number(p.dev).toFixed(2); }
    return '<tr><td>'+src+'</td><td style="text-align:left">'+ts+mt+'</td><td>'+p.entry+'</td>'+
      '<td class="'+(p.main_side==='buy'?'up':'down')+'">'+sd(p.main_side)+'</td><td>'+num(p.main_price)+'</td><td>'+num(p.main_vol)+'</td>'+
      '<td class="'+(p.hedge_side==='buy'?'up':'down')+'">'+sd(p.hedge_side)+'</td><td>'+num(p.hedge_price)+'</td><td>'+num(p.hedge_vol)+'</td>'+
      '<td>'+num(p.spread)+'</td><td>'+num(p.threshold)+'</td><td class="'+devCls+'" title="达标差=点差−阈值(旧HED口径)">'+devTxt+'</td><td class="'+slipCls+'" title="'+slipTitle+'">'+slipTxt+'</td>'+
      '<td>'+num(p.main_fee)+'</td><td>'+num(p.hedge_fee)+'</td>'+
      '<td class="'+((p.main_profit||0)>=0?'up':'down')+'">'+num(p.main_profit)+'</td><td class="'+((p.hedge_profit||0)>=0?'up':'down')+'">'+num(p.hedge_profit)+'</td>'+
      '<td class="'+(pf>=0?'up':'down')+'" style="font-weight:700">'+(pf>=0?'+':'')+pf.toFixed(2)+'</td></tr>';
  });
  __histAll.ht1=trs; __histPg.ht1=1; histRenderTab('ht1','hist-body',18,'该时段无配对成交');
}
