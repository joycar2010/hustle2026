  /* ===== 响应式适配: 平板(≤1024)行转列堆叠; 手机(≤640)列瘦身+隐次要列 ===== */
  /* 顶栏单行策略: 窄屏渐进隐藏密集结算明细, 让顶栏尽量一行不横滚(超窄仍可横滚兜底) */
  @media (max-width:1400px){
    .titlebar .spacer{flex:0 0 0;width:0}
    .netbar{flex-wrap:nowrap;margin-left:auto}
    .netbar .nb-i:nth-child(4), .netbar .nb-i:nth-child(5){display:none}  /* 收起主/对冲逐项明细, 留净利核心 */
  }
  /* 窄屏桌面(641–1280px, 非移动 mobile-mode): 顶栏改换行不横滚 + 盈亏条缩成单值(仅当日总净利润),
     保证 声音/主题/用户 右侧簇永不被挤出屏外 */
  @media (min-width:641px) and (max-width:1280px){
    .titlebar{flex-wrap:wrap;overflow-x:visible;row-gap:4px}
    .titlebar .spacer{display:none}
    .titlebar .usermenu{margin-left:auto}   /* 用户栏靠右, 与声音/主题同处 */
    /* 盈亏条压缩: 只留"当日总净利润"单值(child 3), 隐标签/平仓大值/主对冲明细 */
    .titlebar .netbar{flex:0 0 auto;padding:2px 8px;gap:4px}
    .titlebar .netbar .nb-lbl,
    .titlebar .netbar .nb-big,
    .titlebar .netbar .nb-i:nth-child(4),
    .titlebar .netbar .nb-i:nth-child(5){display:none}
    .titlebar .netbar .nb-i:nth-child(3){font-size:12px}
    .titlebar .netbar .nb-i:nth-child(3) i::before{content:"💰 "}
  }
  @media (max-width:1024px){
    .content{flex-direction:column;gap:10px;overflow-y:auto}
    .top{flex-direction:column;height:auto}
    .klinepanel{margin:8px 0;min-height:240px}
    .orderbook{flex:0 0 auto}
    .userpanel,.userpanel2{margin-left:0;margin-top:8px;flex:1 1 auto}
    #panel-paired{flex:1 1 auto}
    .bottom{flex-direction:column}
  }
  @media (max-width:640px){
    /* 表格瘦身: 隐藏次要列(标记 col-sec 的列), 只留核心 */
    table th.col-sec, table td.col-sec{display:none}
    thead th{padding:7px 5px;font-size:11.5px}
    tbody td{padding:5px 5px;font-size:12px}
    table{font-size:12px}
    /* 顶栏手机化: 单行横滚, 隐藏桌面窗口按钮 + 密集结算明细 */
    .titlebar{gap:6px;padding:5px 8px}
    .titlebar .btn{padding:6px 10px;font-size:12px}
    .titlebar .title{font-size:12px;max-width:44vw;overflow:hidden;text-overflow:ellipsis}
    .titlebar .winbtns{display:none}
    .titlebar .expire{font-size:11px;padding:3px 7px}
    .netbar{gap:4px 8px;padding:2px 6px}
    .netbar .nb-big{font-size:14px}
    /* ===== 手机主体: 账户卡/订单簿 固定宽 → 全宽竖排(根治错位溢出) ===== */
    .accounts{flex-direction:column;width:100%!important;gap:8px}
    .accard{width:100%!important;height:auto!important}
    .klinepanel{margin:8px 0;min-height:220px}
    .orderbook{flex:0 0 auto!important;width:100%}
    .midspace{display:none}
    #panel-paired{flex:1 1 auto!important;width:100%;min-width:0}
    #panel-paired.paired-wide{flex:1 1 auto!important}
    .userpanel,.userpanel2{width:100%;margin-left:0}
    .statusbar{flex-wrap:wrap;height:auto}
    /* K线/点差图降高, 手机不占满屏 */
    .kl-canvas,.sc-wrap{max-height:200px}
    /* 账户卡内边距收紧 */
    .accard{padding:8px}
    /* 触屏最小点击区 */
    button,.btn,.ph-tab th{min-height:34px}
  }
  /* 触屏设备: 禁长按选中/系统菜单干扰(长按=右键菜单由 JS 接管) */
  @media (pointer:coarse){
    .tablecard,.orderbook,.ob-rows,#panel-paired{-webkit-touch-callout:none;-webkit-user-select:none;user-select:none}
  }

  /* ===== 移动底部 Tab 导航: 已取消(改全竖向滚动) ===== */
  .mtabbar{display:none!important}
  @media (max-width:640px){
    /* mobile-mode: 取消 Tab 分屏, 单一自然页面滚动(废除 leftcol 内部嵌套滚动=坑位卡被埋根因) */
    body.mobile-mode .mobile-only{display:block}
    body.mobile-mode .content{flex-direction:column;gap:0;overflow-y:auto;-webkit-overflow-scrolling:touch}
