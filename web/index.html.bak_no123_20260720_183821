    }
    else if(target.closest('.orderbook')){ showAt(ctxClose,x,y); }
    else { showAt(ctx,x,y); }
  }
  document.addEventListener('touchstart',function(e){
    if(e.touches.length!==1)return;
    const t=e.touches[0]; lpStartX=t.clientX; lpStartY=t.clientY; lpFired=false;
    const tgt=e.target;
    lpTimer=setTimeout(function(){
      lpFired=true;
      if(navigator.vibrate)try{navigator.vibrate(15);}catch(_){}    // 触觉反馈
      routeMenu(tgt, lpStartX, lpStartY);
    },500);   // 长按 500ms 阈值
  },{passive:true});
  document.addEventListener('touchmove',function(e){
    if(!lpTimer)return; const t=e.touches[0];
    if(Math.abs(t.clientX-lpStartX)>10||Math.abs(t.clientY-lpStartY)>10){ clearTimeout(lpTimer); lpTimer=null; }   // 滑动即取消(不误触)
  },{passive:true});
  document.addEventListener('touchend',function(e){
    if(lpTimer){ clearTimeout(lpTimer); lpTimer=null; }
    if(lpFired){ e.preventDefault && e.preventDefault(); }   // 长按已触发菜单则吞掉后续 click
  });
})();

