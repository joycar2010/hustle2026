    .ob-foot .spin{flex:0 0 74px}
    .ob-foot .spin input{width:40px;font-size:16px}
    .ob-foot .spin .ar span{font-size:14px;padding:4px 2px}
    .sw{padding:11px}
    .toggle{width:46px;height:26px}
    .toggle::after{width:22px;height:22px}
    .toggle.on::after{left:22px}

    /* ③底部 Tab 贴底(隐 botbar 后自然最后一条) + 安全区计入盒高 */
    .mtabbar{box-sizing:border-box;flex:0 0 auto;min-height:54px}
  }

