// 实时算价: 券预览(服务端) + 积分抵现(本地按30%上限估算, 最终以服务端为准)
let __recalcTimer=null;
function recalcPay(){
  clearTimeout(__recalcTimer);
  __recalcTimer=setTimeout(_recalcPayNow, 250);
}
async function _recalcPayNow(){
  const mode=window.__payMode; if(mode!=='month'&&mode!=='iap')return;
  const kind=(mode==='month')?'subscription':'iap';
  const gross=payAmount();
  let couponDisc=0; const code=($('pay-coupon')||{}).value||'';
  if(code){
    try{
      const body={kind:kind}; if(mode==='month')body.months=renewMonths; else if(window.__payIap)body.product_key=window.__payIap.key;
      const pv=await QH.post('/coupon/preview',{...body,code:code});
      if(pv&&!pv.detail) couponDisc=pv.discount||0; else if(pv&&pv.detail){ toast(pv.detail); if($('pay-coupon'))$('pay-coupon').value=''; }
    }catch(e){}
  }
  window.__couponDisc=couponDisc;
  const afterCoupon=Math.max(0, gross-couponDisc);
  // 积分抵现: 100分=1U, 上限=券后金额30%, 取整到100倍数, 不超可用
  let ptsWant=parseInt(($('pay-points')||{}).value)||0; if(ptsWant<0)ptsWant=0;
  const capU=Math.floor(afterCoupon*0.30);            // 整U上限
  const maxPts=Math.min(ptsWant, capU*100, (window.__ptsAvail||0));
  const ptsUse=Math.floor(maxPts/100)*100;
  const ptsDisc=ptsUse/100;
  window.__ptsUse=ptsUse; window.__ptsDisc=ptsDisc;
  const payable=Math.max(0, afterCoupon-ptsDisc);
  // 更新展示
  const hasDisc=(couponDisc>0||ptsDisc>0);
  $('pay-row-orig').style.display=hasDisc?'':'none'; $('pay-row-disc').style.display=hasDisc?'':'none';
  $('pay-orig').textContent=gross.toFixed(2)+' USDT';
  $('pay-disc').textContent='-'+(couponDisc+ptsDisc).toFixed(2)+' USDT'+(ptsUse>0?(' (含积分'+ptsUse+')'):'');
  $('pay-amt').textContent=payable.toFixed(2)+' USDT';
  $('pay-bal-cost').textContent=payable.toFixed(2);
}
