<!-- ===== 注册/体验、内购 模态已移至顶层(登录前可见,见 #login 之后) ===== -->

<script>

/* ===== QH 实时数据层（接管 demo 的模拟数据） ===== */
const QH={user:null,key:null,started:false,
  async get(p){const r=await fetch('/api'+p);if(!r.ok)throw new Error(r.status);return r.json();},
  async post(p,b){const r=await fetch('/api'+p,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});if(!r.ok&&r.status!==400)throw new Error(r.status);return r.json();},
  start(){ if(this.started)return; this.started=true; window.__LIVE=true; if(typeof applyCoinLabel==='function')applyCoinLabel(); if(typeof applySwitches==='function')applySwitches(); this.connectWS(); this.initLazyCharts(); this.restoreToggles();
    // 逐坑覆盖(买入/卖出点位等)独立周期加载: WS 主路径不加载 __slotov, 否则列表一直回落全局
    refreshSlotov(); if(!this._slotovTimer)this._slotovTimer=setInterval(refreshSlotov, 6000);
    pollConnMode(); if(!this._connTimer)this._connTimer=setInterval(pollConnMode, 10000);
  } ,
  // 恢复红框两个切换按钮的持久化状态(刷新后不复位)
  restoreToggles(){
    try{
      if(localStorage.getItem('qh_acc_hidden')==='1' && !accHidden && typeof toggleAccHide==='function')toggleAccHide();
      if(localStorage.getItem('qh_paired_expanded')==='1' && !pairedExpanded && typeof togglePairedDetail==='function')togglePairedDetail();
    }catch(e){}
  },
  /* 懒加载: 图表仅在进入视口后才首次拉取, 且离开视口时暂停 15s 刷新(省手机 CPU/流量) */
  _scVisible:false, _scInited:false, _scTimer:null,
  initLazyCharts(){
    const self=this;
    const sc=document.getElementById('sc-canvas');
    const startTimer=function(){ if(self._scTimer)return; self._scTimer=setInterval(function(){ if(self._scVisible && typeof scFetch==='function' && !SC.loading)scFetch(); },15000); };
    // 兜底: 登录后无条件先拉一次(不再单纯依赖 IO 可见性触发, 防容器初始隐藏/尺寸0 时图空白)
    if(typeof scQuick==='function'){ this._scInited=true; this._scVisible=true; try{ scQuick(1); }catch(e){} }
    startTimer();
    if(sc && 'IntersectionObserver' in window){
      const io=new IntersectionObserver(function(ents){
        ents.forEach(function(en){
          self._scVisible=en.isIntersecting;
          // 进入视口且尚无数据时补拉一次(兜底已先拉, 这里只在数据为空时补)
          if(en.isIntersecting && typeof scFetch==='function' && !SC.loading && !(SC.fwd&&SC.fwd.length)){ scFetch(); }
        });
      },{threshold:0.05});
      io.observe(sc);
    }
  },
  /* 实时推送: WS 为主, 断线降级为 3s 轮询兜底; 心跳保活 + 指数退避 + 前台/联网自愈重连 */
  ws:null, wsTimer:null, pollTimer:null, hbTimer:null, lastRx:0, backoff:0, wantConnect:false,
  connectWS(){
    this.wantConnect=true;
    try{
      const proto=location.protocol==='https:'?'wss':'ws';
      const ws=new WebSocket(proto+'://'+location.host+'/ws/stream');
      this.ws=ws;
      ws.onopen=()=>{ ws.send(JSON.stringify({license_key:this.key})); this.stopPollFallback(); this.backoff=0; this.lastRx=Date.now(); this.startHeartbeat(); };
      ws.onmessage=(ev)=>{ this.lastRx=Date.now(); try{ const m=JSON.parse(ev.data); if(m.type==='snapshot')renderSnapshot(m); }catch(e){} };
      ws.onclose=()=>{ this.ws=null; this.stopHeartbeat(); this.startPollFallback(); this.scheduleReconnect(); };
      ws.onerror=()=>{ try{ws.close();}catch(e){} };
    }catch(e){ this.startPollFallback(); this.scheduleReconnect(); }
  },
  // 指数退避重连: 1s→2s→4s→…→上限30s(避免断网时疯狂重试打爆)
  scheduleReconnect(){
    if(!this.wantConnect || this.wsTimer) return;
    const delay=Math.min(30000, 1000*Math.pow(2, this.backoff)); this.backoff++;
    this.wsTimer=setTimeout(()=>{ this.wsTimer=null; if(this.wantConnect)this.connectWS(); }, delay);
  },
  // 心跳: 每 20s 发 ping; 若 45s 未收到任何帧判半开死链, 主动关触发重连(修 onclose 不触发的假死)
  startHeartbeat(){
    this.stopHeartbeat();
    this.hbTimer=setInterval(()=>{
      const ws=this.ws; if(!ws||ws.readyState!==1)return;
      if(Date.now()-this.lastRx>45000){ try{ws.close();}catch(e){} return; }   // 半开: 强关走重连
      try{ ws.send(JSON.stringify({type:'ping'})); }catch(e){}
    },20000);
  },
  stopHeartbeat(){ if(this.hbTimer){ clearInterval(this.hbTimer); this.hbTimer=null; } },
  // 前台/联网自愈: 回到前台或网络恢复时, 若 WS 非连通立即重连(不等退避)
  wakeReconnect(){
    if(!this.wantConnect)return;
    const ws=this.ws;
    if(!ws||ws.readyState>1){ this.backoff=0; if(this.wsTimer){clearTimeout(this.wsTimer);this.wsTimer=null;} this.connectWS(); }
  },
  startPollFallback(){ if(this.pollTimer)return; this.poll(); this.pollTimer=setInterval(()=>this.poll(),3000); },
  stopPollFallback(){ if(this.pollTimer){ clearInterval(this.pollTimer); this.pollTimer=null; } },
  async poll(){
    // 双腿账户卡 + 连接状态 + 持仓(供获利汇总)
    let _pos=null;
    try{ const ov=await this.get('/engine/slot_overrides?username='+encodeURIComponent(this.user)+'&symbol='+encodeURIComponent(window.QHSYM||'XAUUSD')); window.__slotov=(ov&&ov.slots)||{}; }catch(e){}
    try{ const legs=await this.get('/engine/legs'); const ms=legs.status&&legs.status.main, hs=legs.status&&legs.status.hedge;
      if(ms){ fillAcct('m',ms,'MT5'); } if(hs){ fillAcct('h',hs,'MT5'); }
      _pos=legs.positions; window.__lastPositions=legs.positions; window.__remoteBusy=(legs.busy_slots||[]); renderPosLive(legs.positions);
    }catch(e){}
    // 主账户实时报价(ASK/BID)+利润
    let _mt=null;
    try{ const acc=await this.get('/bridge/account').catch(()=>null);
      if(acc && !(window.__unreg&&window.__unreg.m)){ setTxt('m-pnl',sign(acc.profit)); cls('m-pnl','v '+(acc.profit>=0?'up':'down')); setHtml('m-tri',acc.profit>=0?SVGI('i-tri-up'):SVGI('i-tri-down')); cls('m-tri','tri '+(acc.profit>=0?'up':'down')); }
      const t=await this.get('/quote/tick/'+(window.QHSYM||'XAUUSD')).catch(()=>null);
      if(t){ setTxt('mk-m-ask',fnum(t.ask)); setTxt('mk-m-bid',fnum(t.bid)); window.__lastTick=t; _mt=t; }
    }catch(e){}
    // 综合盈亏 + 引擎/市场 (顺带拿到对冲品种映射)
    let _hedgeSym=(window.QHSYM||'XAUUSD');
    try{ const st=await this.get('/engine/state'); const ev=st.eval&&st.eval[this.user];
      if(ev&&ev.hedge_symbol)_hedgeSym=ev.hedge_symbol;
      if(ev&&ev.ladders!=null)window.__ladders=ev.ladders;
      if(ev&&ev.entry_spread!=null)window.__gEntry=ev.entry_spread;
      if(ev&&ev.g_tp_points!=null)window.__gTp=ev.g_tp_points;
      window.__hedgeSym=_hedgeSym;
      const seg=document.querySelectorAll('.statusbar .seg'); if(seg[3])seg[3].textContent='状态: '+((st.market&&st.market.closed)?'休市':(engineRunning()?'运行':'已停止')); if(seg[2])seg[2].textContent='单量: '+(st.cycle?st.cycle.pairs:0);
      const be=$('bs-eng'); if(be)be.textContent=engineRunning()?'运行中':'已停止';
    }catch(e){}
    // ② 蓝框: 获利=所有坑位未平仓浮盈汇总(主腿+对冲腿) ; 反向Ask/正向Bid=当前开仓点差
    try{
      const ht=await this.get('/quote/tick/'+encodeURIComponent(_hedgeSym)+'?leg=hedge').catch(()=>null);
      if(ht){ setTxt('mk-h-ask',fnum(ht.ask)); setTxt('mk-h-bid',fnum(ht.bid)); }
      // 获利汇总
      const ml=((_pos&&_pos.main&&(_pos.main.positions||_pos.main))||[]);
      const hl=((_pos&&_pos.hedge&&(_pos.hedge.positions||_pos.hedge))||[]);
      let pf=0; ml.forEach(p=>pf+=Number(p.profit||0)); hl.forEach(p=>pf+=Number(p.profit||0));
      const pe=$('t-profit'); if(pe){ pe.textContent=fnum(pf); pe.className=(pf>=0?'up':'down'); }
      const tri=$('t-profit-tri'); if(tri)tri.innerHTML=pf>=0?SVGI('i-tri-up'):SVGI('i-tri-down');
      // 反向开仓(主卖+对冲买): 点差 = 对冲ASK − 主BID ; 正向开仓(主买+对冲卖): 主ASK − 对冲BID
      if(_mt&&ht&&_mt.bid!=null&&ht.ask!=null){
