    pushAlert('info', role+' 账户已登记 · '+modeLbl+(mode==='api'?'·已接入':'·凭证留bridge'));
    // 重注册产生新接入时, 旧注册释放结果透明化(成功=自动释放; 失败=提示后台处理防配额泄漏)
    if(mode==='api' && r.a2t_prev_msg){
      pushAlert(r.a2t_prev_released?'info':'warn', '旧账户注册: '+String(r.a2t_prev_msg).replace(/云端/g,''));
    }
