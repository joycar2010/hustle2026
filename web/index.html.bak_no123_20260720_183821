    }
  }
}

/* ============ BOTTOM BAR CLOCK ============ */
let bt=new Date(2026,5,27,14,32,15);
setInterval(()=>{
  bt=new Date(bt.getTime()+1000);
  const p=n=>String(n).padStart(2,'0');
  const bc=$('bs-clock'); if(bc)bc.textContent=`2026-06-27 ${p(bt.getHours())}:${p(bt.getMinutes())}:${p(bt.getSeconds())}`;
},1000);
/* engine state mirror to bottom bar + marquee */
const _origSetRunning=setRunning;
let _engInited=false;
setRunning=function(on){
  const changed=_engInited && (on!==running);
  _origSetRunning(on);
  const e=$('bs-eng'); if(e)e.textContent=on?'运行中':'已停止';
  if(changed && typeof pushAlert==='function'){ pushAlert(on?'info':'warn', on?'引擎已启动 · 开始监控':'引擎已停止 · 暂停下单'); }
  _engInited=true;
};
setRunning(engineRunning());   // 初始按真实档位(未知=false), 首轮轮询校正

/* ============ MARQUEE (飞书镜像跑马灯) ============ */
let mqMirror=true;       // 受飞书"镜像到跑马灯"开关控制
let mqPaused=false;
const mqInner=$('mq-inner'), mqEl=$('marquee');
const mqSeed=[
  ['info','系统就绪 · 等待实时告警与公告'],
];
function mqHTML(lv,msg,tm){
  const p=n=>String(n).padStart(2,'0');
  tm=tm||`${p(bt.getHours())}:${p(bt.getMinutes())}:${p(bt.getSeconds())}`;
  const lab={info:'INFO',warn:'WARN',err:'ERR'}[lv];
  return `<span class="mq-item"><span class="lv ${lv}">${lab}</span><span class="tm">${tm}</span><span>${msg}</span></span>`;
}
function renderMq(){
  // 内容复制两份保证无缝滚动
  const html=mqSeed.map(s=>mqHTML(s[0],s[1])).join('');
  mqInner.innerHTML=html+html;
}
renderMq();
/* 只写系统日志(不进跑马灯) — 引擎告警走此路, 跑马灯统一由 pollMarquee 后端合并馈源 */
function logAlert(lv,msg){
  const log=$('log');
  if(log){
    const p=n=>String(n).padStart(2,'0');
    const tm=`${p(bt.getHours())}:${p(bt.getMinutes())}:${p(bt.getSeconds())}`;
    const e=document.createElement('div');e.className='e';
    e.innerHTML=`<span class="tag ${lv}">${({info:'INFO',warn:'WARN',err:'ERR'})[lv]}</span><span class="tm">${tm}</span><span class="msg">${msg}</span>`;
    log.insertBefore(e,log.firstChild); while(log.children.length>20)log.removeChild(log.lastChild);
  }
}
/* 向跑马灯推送一条（同时进系统日志） — 供本地即时 UX 提示(参数保存/开关切换等) */
function pushAlert(lv,msg){
  logAlert(lv,msg);
  if(!mqMirror) return;            // 飞书开关关闭则不镜像
  mqSeed.unshift([lv,msg]); if(mqSeed.length>14)mqSeed.pop();
  renderMq();
  if(lv==='err'){ mqEl.classList.add('flash'); setTimeout(()=>mqEl.classList.remove('flash'),10*1000); }
}
function toggleMq(){
  mqPaused=!mqPaused;
  mqInner.classList.toggle('paused',mqPaused);
  $('mq-mute').innerHTML=mqPaused?SVGI('i-play'):SVGI('i-pause');
}
/* 网站通知/公告跑马灯: 轮询后端广播馈源(P2-5 /notify/marquee/recent), 替代原演示定时器 */
async function pollMarquee(){
  try{
    const r=await QH.get('/notify/marquee/recent?limit=20');
    const items=(r&&r.items)||[];
    if(!QH._mqSeen)QH._mqSeen=new Set();
    // 后端返回最新在前, 逆序推入使旧的先进
    items.slice().reverse().forEach(it=>{
      const key=(it.ts||'')+(it.title||'')+(it.content||'');
      if(QH._mqSeen.has(key))return; QH._mqSeen.add(key);
      const lv = it.priority>=2 ? 'err' : (it.priority===1 ? 'warn' : 'info');
      const msg = (it.title?('【'+it.title+'】'):'')+(it.content||'');
      if(!mqMirror) return;
      mqSeed.unshift([lv,msg]); if(mqSeed.length>14)mqSeed.pop();
      renderMq();
      if(it.blink){ mqEl.classList.add('flash'); setTimeout(()=>mqEl.classList.remove('flash'),10*1000); }
      if(it.sound && it.sound!=='none' && typeof speakAlert==='function') speakAlert(it.title||it.content||'新通知', it.sound);
    });
  }catch(e){}
}
setInterval(pollMarquee, 15000); pollMarquee();


/* 飞书"镜像到跑马灯"开关联动：弹框里最后一个开关 */
function bindFeishuMirror(){
  const sws=document.querySelectorAll('#feishu-mask .sw');
  const mir=[...sws].find(s=>s.querySelector('.t')?.textContent.includes('跑马灯'));
  if(mir){ const tg=mir.querySelector('.toggle');
    tg.addEventListener('click',()=>{ mqMirror=tg.classList.contains('on');
      toast(mqMirror?'已开启跑马灯镜像':'已关闭跑马灯镜像'); });
  }
}
bindFeishuMirror();
