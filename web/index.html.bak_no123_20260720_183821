    const r=await QH.get('/accounts/'+QH.user);
    const sel=$('acct-pick'); sel.innerHTML='';
    (r.accounts||[]).forEach(a=>{ const o=document.createElement('option'); o.value=a.login;
      o.textContent=a.label+' · '+a.login+' ('+a.broker+'/'+a.conn_mode+')'; o.dataset.role=a.role; sel.appendChild(o); });
    want=(r.accounts||[]).find(a=>a.role===(isMain?'main':'hedge'))||null;
