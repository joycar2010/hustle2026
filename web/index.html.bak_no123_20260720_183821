    /* 主订单号(1) 独占首行; 买入点位(6)/卖出点位(7)/获利(8) 排第二行 */
    body.mobile-mode #otable td:nth-child(1){grid-column:1/4;grid-row:1;font-weight:700}
    body.mobile-mode #otable td:nth-child(6){grid-column:1;grid-row:2}
    body.mobile-mode #otable td:nth-child(7){grid-column:2;grid-row:2}
    body.mobile-mode #otable td:nth-child(8){grid-column:3;grid-row:2;font-weight:700}
  }
/* ===== SVG 图标系统(矢量扁平, currentColor 按背景自适应) ===== */
.svgi{width:1em;height:1em;fill:currentColor;vertical-align:-.12em;flex:none;display:inline-block}
.mtab-btn .svgi{width:1.35em;height:1.35em;vertical-align:-.2em}
.mnav-item .svgi,.mnav-btn .svgi,.mi .svgi{width:1.15em;height:1.15em}
.mi-ic .svgi,.mq-ic .svgi{width:1.1em;height:1.1em;vertical-align:-.15em}
.ip .svgi{width:1.05em;height:1.05em;opacity:.7}
.tri .svgi,.pt .svgi{width:.85em;height:.85em;vertical-align:0}
#acct-fab .svgi{width:1.4em;height:1.4em}
.mi.on .svgi{opacity:1}.mi:not(.on) .svgi{opacity:.45}
/* ===== 会员中心(qhwww 浅色配色: 底#E9ECF3 品牌#08113A logo#2E8BD6 文字#1a2033 绿#1aa86a) ===== */
.pm-dlg{background:#E9ECF3}
.pm-body{color:#1a2033}
.pm-cards{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.pm-card{flex:1;min-width:150px;background:#FFFFFF;border:1px solid #dde2ee;border-radius:12px;padding:14px;box-shadow:0 1px 4px rgba(8,17,58,.05)}
.pm-card-brand{background:linear-gradient(135deg,#08113A,#2E8BD6);border:none;color:#fff}
.pm-card .pm-k{font-size:12px;color:#8a93a8;margin-bottom:6px}
.pm-card-brand .pm-k{color:rgba(255,255,255,.8)}
.pm-lvl{font-size:18px;font-weight:800;color:#fff}
.pm-sub{font-size:11px;color:rgba(255,255,255,.85);margin-top:6px}
.pm-big{font-size:24px;font-weight:800;line-height:1.1}
.pm-u{font-size:12px;font-weight:600;color:#8a93a8}
.pm-green{color:#1aa86a}.pm-amber{color:#e0863a}
.pm-btn{margin-top:8px;background:#2E8BD6;color:#fff;border:none;border-radius:6px;padding:5px 14px;font-size:12px;font-weight:600;cursor:pointer}
.pm-btn:hover{background:#2477bd}
.pm-sec{font-weight:700;color:#08113A;font-size:14px;margin:14px 0 8px;padding-left:8px;border-left:3px solid #2E8BD6}
.pm-acts{display:flex;flex-direction:column;gap:6px}
.pm-act{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid #dde2ee;border-radius:8px;padding:9px 12px;font-size:13px;color:#1a2033}
.pm-act .pm-act-tag{font-size:11px;color:#fff;background:#e0683a;border-radius:10px;padding:2px 8px;font-weight:600}
.pm-empty{color:#8a93a8;font-size:12px;text-align:center;padding:10px}
.pm-catalog{display:flex;flex-wrap:wrap;gap:8px}
.pm-item{flex:1;min-width:170px;background:#fff;border:1px solid #dde2ee;border-radius:8px;padding:10px}
.pm-item .pm-item-n{color:#1a2033;font-size:13px}
.pm-item .pm-item-b{display:flex;justify-content:space-between;align-items:center;margin-top:8px}
.pm-item .pm-item-c{color:#e0863a;font-weight:700}
.pm-invite{background:#fff;border:1px solid #dde2ee;border-radius:8px;padding:12px}
.pm-invrow{display:flex;gap:8px;align-items:center}
.pm-invrow input{flex:1;background:#eaf0fa;color:#1a6bbf;border:1px solid #dde2ee;border-radius:6px;padding:7px;font-size:12px}
.pm-invtip{font-size:11px;color:#8a93a8;margin-top:8px}.pm-invtip b{color:#1aa86a}
.pm-ledger{max-height:170px;overflow:auto;background:#fff;border:1px solid #dde2ee;border-radius:8px;padding:4px 10px}
.pm-lrow{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #eef1f7;font-size:12px;color:#46506e}
.pm-lrow:last-child{border-bottom:none}
.pm-lrow .pm-ld-pos{color:#1aa86a;font-weight:600}.pm-lrow .pm-ld-neg{color:#e0683a;font-weight:600}
body.dark .pm-dlg{background:#0f1728}
body.dark .pm-body{color:#dbe6ea}
body.dark .pm-card{background:#141c2e;border-color:#243056}
body.dark .pm-sec{color:#8fbfe6}
body.dark .pm-act,body.dark .pm-item,body.dark .pm-invite,body.dark .pm-ledger{background:#141c2e;border-color:#243056;color:#dbe6ea}
body.dark .pm-item .pm-item-n{color:#dbe6ea}
body.dark .pm-invrow input{background:#0b1220;color:#8fbfe6;border-color:#243056}
/* ===== AI 套利分析(量化信号终端风) ===== */
#arb-mask .dlg{width:760px;max-width:96vw}
.arb-loading{text-align:center;padding:44px;color:#8a959b;font-size:13px}
.arb-spin{display:inline-block;width:14px;height:14px;border:2px solid #cdd6e6;border-top-color:#2E8BD6;border-radius:50%;vertical-align:-2px;animation:arbspin .7s linear infinite}
@keyframes arbspin{to{transform:rotate(360deg)}}
/* KPI 头部带: 深蓝量化仪表条 */
.arb-kpi{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:1px;background:#26324f;border:1px solid #26324f;border-radius:10px;overflow:hidden;margin-bottom:14px}
.arb-kpi .k{background:linear-gradient(160deg,#0c1730,#12203d);padding:11px 14px}
.arb-kpi .k.verdict{background:linear-gradient(135deg,#0c1730,#1b3a5c)}
.arb-kpi .k .kl{font-size:10px;color:#7e90b4;letter-spacing:.5px;text-transform:uppercase}
.arb-kpi .k .kv{font-family:var(--num);font-size:20px;font-weight:800;color:#eaf2ff;margin-top:3px;line-height:1.1}
.arb-kpi .k .kv.sm{font-size:14px;font-weight:700;line-height:1.35}
.arb-kpi .k .kv .u{font-size:11px;color:#7e90b4;font-weight:600;margin-left:2px}
.arb-kpi .k .kv.ok{color:#3ddc84} .arb-kpi .k .kv.warn{color:#ffca5f}
.arb-sec-t{font-size:12px;font-weight:700;color:#08113A;letter-spacing:.4px;margin:2px 2px 8px;padding-left:8px;border-left:3px solid #2E8BD6;display:flex;align-items:center;gap:8px}
.arb-cnt{font-size:11px;color:#8a959b;font-weight:600}
.arb-tagr{font-size:10px;font-weight:700;color:#2E8BD6;background:#eaf0fa;border:1px solid rgba(46,139,214,.28);padding:1px 8px;border-radius:999px}
.arb-card.radar{opacity:.94}
.arb-card.radar .sym::after{content:"待接入";font-size:10px;font-weight:600;color:#8a959b;background:#f0f2f7;border-radius:999px;padding:1px 7px;margin-left:2px}
.arb-list{display:flex;flex-direction:column;gap:8px}
/* 信号卡 */
.arb-card{display:grid;grid-template-columns:1fr auto;gap:10px 14px;background:#fff;border:1px solid #e2e8f4;border-radius:10px;padding:12px 14px;position:relative;overflow:hidden}
.arb-card::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px}
.arb-card.s-ok::before{background:#16a34a} .arb-card.s-near::before{background:#e6a23c} .arb-card.s-low::before{background:#c0c8d6}
.arb-card .sym{display:flex;align-items:center;gap:8px;font-weight:800;color:#08113A;font-size:14px}
.arb-card .sym .swap{color:#2E8BD6}
.arb-legs{display:flex;gap:10px;margin-top:7px;font-size:11px}
.arb-leg{display:flex;align-items:center;gap:4px;color:#5a678a}
.arb-dot{width:7px;height:7px;border-radius:50%;background:#c0c8d6}
.arb-dot.on{background:#16a34a;box-shadow:0 0 4px rgba(22,163,74,.5)}
.arb-dot.off{background:#e0683a}
/* 基差 vs 阈值 迷你条 */
.arb-basis{margin-top:9px;font-size:11px;color:#5a678a}
.arb-basis .bt{display:flex;justify-content:space-between;font-family:var(--num);margin-bottom:3px}
.arb-basis .bt b{color:#08113A}
.arb-bar{height:7px;background:#eef1f7;border-radius:4px;overflow:hidden;position:relative}
.arb-bar .fill{height:100%;border-radius:4px}
.arb-bar .thr{position:absolute;top:-2px;bottom:-2px;width:2px;background:#08113A;opacity:.55}
/* 隔夜利息(swap)行 */
.arb-swap{display:flex;align-items:center;gap:7px;margin-top:9px;padding:6px 9px;border-radius:7px;font-size:11px;
  background:#f4f7fb;border:1px solid #e7ecf5}
.arb-swap .sw-k{color:#8a95a8;font-size:10.5px;flex:0 0 auto}
.arb-swap .sw-v{font-family:var(--num);font-weight:800;font-size:13px}
.arb-swap .sw-dir{font-size:10px;color:#5a678a;background:#e9eefa;border-radius:999px;padding:1px 7px}
.arb-swap .sw-tip{margin-left:auto;font-size:10.5px;font-weight:600}
.arb-swap.pos{background:#eefaf2;border-color:#c9ecd8}
.arb-swap.pos .sw-v,.arb-swap.pos .sw-tip{color:#12a150}
.arb-swap.neg{background:#fdf1f0;border-color:#f6d5d2}
.arb-swap.neg .sw-v,.arb-swap.neg .sw-tip{color:#e04a3f}
.arb-swap.na{background:#f4f5f7;border-color:#e7e9ee}
.arb-swap.na .sw-v{color:#9aa2b0;font-weight:600;font-size:11px}
body.dark .arb-swap{background:#131f3a;border-color:#243056}
body.dark .arb-swap.pos{background:#0f2a1e;border-color:#1f5a3c}
body.dark .arb-swap.neg{background:#2e1513;border-color:#5a2a26}
body.dark .arb-swap.na{background:#131f3a;border-color:#243056}
/* 评分环 + 状态 */
.arb-score{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:96px}
.arb-ring{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;position:relative}
.arb-ring .rv{font-family:var(--num);font-weight:800;font-size:19px}
.arb-ring .ru{font-size:9px;color:#8a959b}
.arb-chip{margin-top:6px;font-size:11px;font-weight:700;padding:2px 10px;border-radius:999px}
.arb-chip.ok{background:#e5f7ec;color:#16a34a} .arb-chip.near{background:#fdf3e3;color:#e6a23c} .arb-chip.low{background:#eef1f7;color:#8a959b}
.arb-suggest{grid-column:1/-1;font-size:12px;color:#46506e;border-top:1px dashed #e5e8f0;padding-top:8px;margin-top:2px}
.arb-empty{color:#8a959b;text-align:center;padding:26px;font-size:13px}
/* AI 研判终端 */
.arb-narrate{margin-top:12px;background:#0c1730;border:1px solid #26324f;border-radius:10px;padding:14px 16px;font-size:13px;line-height:1.75;color:#c8d6ef;white-space:pre-wrap;position:relative}
.arb-narrate .ai-tag{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:#8fbaff;letter-spacing:.5px;margin-bottom:8px;text-transform:uppercase}
.arb-foot-note{font-size:11px;color:#96a2b8;margin-top:12px;line-height:1.6}
body.dark .arb-card{background:#101a33;border-color:#243056}
body.dark .arb-card .sym{color:#dbe6ea}
body.dark .arb-sec-t{color:#8fbfe6}
body.dark .arb-bar{background:#1a2740}
@media (max-width:640px){
  .arb-kpi{grid-template-columns:1fr 1fr}
  .arb-card{grid-template-columns:1fr}
  .arb-score{flex-direction:row;gap:12px;min-width:0;justify-content:flex-start}
}
</style>
</head>
