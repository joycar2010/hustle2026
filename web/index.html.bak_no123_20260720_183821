/* ===== 模态框拖拽(PC鼠标+移动触摸统一走 Pointer Events); 抓 .dh 标题栏拖 .dlg ===== */
(function(){
  let drag=null;
  document.addEventListener('pointerdown', function(e){
    const dh=e.target.closest && e.target.closest('.dh'); if(!dh) return;
    if(e.target.closest('button, input, select, textarea, a, .x, svg')) return; // 点关闭/控件不触发拖拽
    const dlg=dh.closest('.dlg'); if(!dlg) return;
    drag={dlg:dlg, sx:e.clientX, sy:e.clientY, ox:parseFloat(dlg.dataset.dx||0), oy:parseFloat(dlg.dataset.dy||0)};
    dlg.style.transition='none';
    try{ dh.setPointerCapture(e.pointerId); }catch(_){}
    e.preventDefault();
  }, {passive:false});
  document.addEventListener('pointermove', function(e){
    if(!drag) return;
    const dx=drag.ox+(e.clientX-drag.sx), dy=drag.oy+(e.clientY-drag.sy);
    drag.dlg.dataset.dx=dx; drag.dlg.dataset.dy=dy;
    drag.dlg.style.transform='translate('+dx+'px,'+dy+'px)';
  }, {passive:true});
  function end(){ drag=null; }
  document.addEventListener('pointerup', end);
  document.addEventListener('pointercancel', end);
})();
/* ===== 统一风格弹窗(替代原生 confirm/prompt/alert), 复用 .mask/.dlg 主界面风格 ===== */
function uiModal(opts){
  return new Promise(function(resolve){
    const mask=document.createElement('div'); mask.className='mask show'; mask.style.zIndex='560';
    const dangerCss=opts.danger?'background:linear-gradient(#e0683a,#c8502a)':'';
    const inp = opts.input ? ('<div style="margin-top:12px"><label style="display:block;font-size:12px;color:var(--lbl);margin-bottom:5px">'+(opts.input.label||'')+'</label><input id="__ui_inp" type="'+(opts.input.type||'text')+'" placeholder="'+(opts.input.placeholder||'')+'" style="width:100%;border:1px solid #b8c0c5;border-radius:4px;padding:8px;font-size:13px;font-family:var(--num);outline:none;background:#fff"></div>') : '';
    const _uiIcon = opts.input ? 'i-key' : (opts.danger ? 'i-warning' : 'i-check');
    mask.innerHTML='<div class="dlg" style="width:440px"><div class="dh"><b><svg class="svgi"><use href="#'+_uiIcon+'"/></svg> '+(opts.title||'确认')+'</b><span class="sp"></span><button class="x" data-act="cancel"><svg class="svgi"><use href="#i-close"/></svg></button></div>'+
      '<div class="db" style="font-size:13.5px;line-height:1.7;white-space:pre-wrap">'+(opts.html||'')+inp+'</div>'+
      '<div class="df">'+(opts.noCancel?'':'<button class="btn-ghost" data-act="cancel">'+(opts.cancelText||'取消')+'</button>')+
      '<button class="btn-primary" data-act="ok" style="'+dangerCss+'">'+(opts.okText||'确定')+'</button></div></div>';
    document.body.appendChild(mask);
    const inpEl=mask.querySelector('#__ui_inp'); if(inpEl)setTimeout(function(){inpEl.focus();},30);
    function done(v){ mask.remove(); document.removeEventListener('keydown',onkey); resolve(v); }
    function onok(){ done(opts.input ? (inpEl?inpEl.value.trim():'') : true); }
    function oncancel(){ done(opts.input ? null : false); }
    mask.querySelectorAll('[data-act]').forEach(function(b){ b.addEventListener('click',function(){ b.dataset.act==='ok'?onok():oncancel(); }); });
    function onkey(e){ if(e.key==='Escape')oncancel(); else if(e.key==='Enter')onok(); }
    document.addEventListener('keydown',onkey);
  });
}
