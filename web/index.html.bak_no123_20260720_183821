<script>
var __qhchatOpen=false, __qhchatId=localStorage.getItem('qh_chat_extid')||('web_'+Math.random().toString(36).slice(2,10));
localStorage.setItem('qh_chat_extid',__qhchatId);
var __qhchatKey='qh_chat_history', __qhchatMsgs=[];
try{ __qhchatMsgs=JSON.parse(localStorage.getItem(__qhchatKey)||'[]'); }catch(e){ __qhchatMsgs=[]; }
function __qhSave(){ try{ localStorage.setItem(__qhchatKey, JSON.stringify(__qhchatMsgs.slice(-200))); }catch(e){} }
function __qhCnt(){ var e=document.getElementById('qhchat-cnt'); if(e)e.textContent=__qhchatMsgs.length?(__qhchatMsgs.length+' 条'):''; }
function qhChatToggle(){ __qhchatOpen=!__qhchatOpen; var c=document.getElementById('qhchat'); c.style.display=__qhchatOpen?'flex':'none';
  if(__qhchatOpen)qhChatRender(); }
function qhChatRender(){
  var b=document.getElementById('qhchat-body'); if(!b)return; b.innerHTML='';
  if(!__qhchatMsgs.length){ b.innerHTML='<div style="text-align:center;color:#8a93a8;font-size:12px;padding:26px 10px">您好!我是 Quant Hedge 智能客服。<br>有任何使用问题都可以问我。</div>'; __qhCnt(); return; }
  __qhchatMsgs.forEach(function(m){
    var me=m.role==='me'; var row=document.createElement('div');
    row.style.cssText='position:relative;display:flex;justify-content:'+(me?'flex-end':'flex-start')+';margin:6px 0';
    row.onmouseover=function(){ var x=row.querySelector('.qh-del'); if(x)x.style.display='flex'; };
    row.onmouseout=function(){ var x=row.querySelector('.qh-del'); if(x)x.style.display='none'; };
    row.innerHTML='<span style="display:inline-block;max-width:80%;padding:7px 10px;border-radius:9px;line-height:1.5;white-space:pre-wrap;word-break:break-word;background:'+(me?'rgba(46,139,214,.14);border:1px solid rgba(46,139,214,.35);color:#08113A':'#fff;border:1px solid #e1e6f0;color:#08113A')+'">'+(m.text||'').replace(/</g,'&lt;')+'</span>'+
      '<span class="qh-del" onclick="qhChatDel(\''+m.id+'\')" title="删除" style="display:none;position:absolute;top:-7px;'+(me?'left:-7px':'right:-7px')+';width:18px;height:18px;border-radius:50%;background:#fff;border:1px solid #dde2ee;color:#8a93a8;font-size:12px;align-items:center;justify-content:center;cursor:pointer">×</span>';
    b.appendChild(row);
  });
  b.scrollTop=b.scrollHeight; __qhCnt();
}
function qhChatPush(role,text){ __qhchatMsgs.push({id:'m'+Date.now()+Math.random().toString(36).slice(2,5),role:role,text:text}); __qhSave(); qhChatRender(); }
function qhChatDel(id){ __qhchatMsgs=__qhchatMsgs.filter(function(m){return m.id!==id;}); __qhSave(); qhChatRender(); }
function qhChatClear(){ if(!__qhchatMsgs.length)return; if(!confirm('确定清空所有对话记录？此操作不可撤销。'))return; __qhchatMsgs=[]; __qhSave(); qhChatRender(); }
async function qhChatSend(){ var i=document.getElementById('qhchat-in'); var t=(i.value||'').trim(); if(!t)return; i.value=''; qhChatPush('me',t);
  try{ const r=await fetch('/api/ai/chat',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({site:'qh',conversation_id:(window.__qhConvId||null),message:t,user_id:(window.QH&&QH.user)||__qhchatId})});
    const j=await r.json(); if(j.conversation_id)window.__qhConvId=j.conversation_id;
    if(j.reply)qhChatPush('ai',j.reply); else if(j.detail)qhChatPush('ai',j.detail); }catch(e){ qhChatPush('ai','网络繁忙,请稍后重试'); } }
</script>
