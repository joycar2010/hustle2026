var HIST_PS=50;
var __histAll={ht1:[],ht2:[],ht3:[]}, __histPg={ht1:1,ht2:1,ht3:1};
var __histMeta={ht1:['hist-body',18,'该时段无配对成交'],ht2:['main-deals',8,'暂无成交'],ht3:['hedge-deals',8,'暂无成交']};
function histRenderTab(tab,tbodyId,colspan,emptyMsg){
  const tb=$(tbodyId); if(!tb)return; const all=__histAll[tab]||[]; const pgEl=$('pg-'+tab);
  if(!all.length){ tb.innerHTML='<tr><td colspan="'+colspan+'" style="text-align:center;padding:14px;color:#8aa0a8">'+emptyMsg+'</td></tr>'; if(pgEl)pgEl.innerHTML=''; return; }
  const pages=Math.max(1,Math.ceil(all.length/HIST_PS)); let p=__histPg[tab]||1; p=Math.min(pages,Math.max(1,p)); __histPg[tab]=p;
  tb.innerHTML=all.slice((p-1)*HIST_PS,p*HIST_PS).join('');
  if(pgEl)pgEl.innerHTML='<button class="ph-q" '+(p<=1?'disabled':'')+' onclick="histGo(\''+tab+'\','+(p-1)+')" title="上一页">‹ 上一页</button>'+
    '<span style="margin:0 10px;color:#5f7780;font-size:12px">第 '+p+'/'+pages+' 页 · 共 '+all.length+' 条(每页'+HIST_PS+')</span>'+
    '<button class="ph-q" '+(p>=pages?'disabled':'')+' onclick="histGo(\''+tab+'\','+(p+1)+')" title="下一页">下一页 ›</button>';
}
function histGo(tab,p){ __histPg[tab]=p; const m=__histMeta[tab]; if(m)histRenderTab(tab,m[0],m[1],m[2]); }
function exportPaired(){
  const r=window.__paired; if(!r||!r.pairs||!r.pairs.length){ toast('无数据可导出'); return; }
  const head=['来源','时间','开平','主方向','主价','主手数','对冲方向','对冲价','对冲手数','点差','阈值','达标差','执行滑点','主费','对冲费','主盈亏','对冲盈亏','配对净盈亏'];
  const lines=[head.join(',')];
  r.pairs.forEach(function(p){ const t=p.time?new Date((p.time+28800)*1000).toISOString().slice(0,19).replace('T',' '):'';  /* 北京 */
    lines.push([p.source,t,p.entry,p.main_side,p.main_price,p.main_vol,p.hedge_side,p.hedge_price,p.hedge_vol,p.spread,p.threshold,p.dev,p.slippage,p.main_fee,p.hedge_fee,p.main_profit,p.hedge_profit,p.pair_profit].join(',')); });
  const blob=new Blob(['﻿'+lines.join('\n')],{type:'text/csv;charset=utf-8'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='paired_history.csv'; a.click();
}

