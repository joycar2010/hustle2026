function __speakBrowser(text, cfg){
  try{
    if(!('speechSynthesis' in window)) return;
    var u=new SpeechSynthesisUtterance(String(text).replace(/<[^>]+>/g,'').slice(0,120));
    u.lang=(cfg&&cfg.lang)||'zh-CN';
    u.rate=(cfg&&Number(cfg.rate))||1.05;
    u.pitch=(cfg&&Number(cfg.pitch))||1.1;
    var vs=window.speechSynthesis.getVoices()||[]; var voice=null;
    if(cfg&&cfg.voice_hint){ try{ var re=new RegExp(cfg.voice_hint,'i'); voice=vs.find(function(v){return re.test(v.name)||re.test(v.lang)}); }catch(e){} }
    if(!voice) voice=vs.find(function(v){return /zh|Chinese/i.test(v.lang)&&/female|女|Ting|Yaoyao|Xiaoxiao|Huihui/i.test(v.name)})||vs.find(function(v){return /zh|Chinese/i.test(v.lang)});
    if(voice)u.voice=voice;
    window.speechSynthesis.cancel(); window.speechSynthesis.speak(u);
  }catch(e){}
}
function speakAlert(text, soundKey){
  if(!__soundOn || !text) return;
  var cfg=(soundKey && __soundCfg[soundKey]) ? __soundCfg[soundKey] : null;
  var clean=String(text).replace(/<[^>]+>/g,'').slice(0,180);
  // edge 引擎: 拉服务端合成的 MP3 播放; 失败回落浏览器 TTS
  if(cfg && cfg.engine==='edge' && soundKey){
    try{
      if(__ttsAudio){ try{__ttsAudio.pause();}catch(e){} __ttsAudio=null; }
      var url='/api/notify/tts?key='+encodeURIComponent(soundKey)+'&text='+encodeURIComponent(clean);
      __ttsAudio=new Audio(url);
      __ttsAudio.play().catch(function(){ __speakBrowser(clean, cfg); });
      return;
    }catch(e){ __speakBrowser(clean, cfg); return; }
  }
  __speakBrowser(clean, cfg);
}
