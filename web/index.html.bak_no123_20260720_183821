<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>【Quant Hedge】对冲工具软件</title>
<link rel="icon" href="QHEDGELOGO-s-single.ico">
<link rel="shortcut icon" href="QHEDGELOGO-s-single.ico">
<!-- PWA 原生壳 -->
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#08113a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Quant Hedge">
<link rel="apple-touch-icon" href="QHEDGELOGO-512.png">
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  :root{
    /* 品牌深蓝配色 (logo: 深海军蓝#08113A + azure logo-blue; 画布冷调灰蓝降眩光, 卡片浮白) */
    --teal-deep:#040E32; --teal:#08113A; --teal-soft:#2a3566; --teal-pale:#eaf0fa;
    --bar1:#08113A; --bar2:#040E32;
    --accent:#08113A; --accent2:#040E32; --logo:#2E8BD6;
    --blue:#2962ff; --red:#e53935; --yellow:#ffe7a0;
    --gray:#E9ECF3; --line:#c2c7d4; --cardline:#dde2ee;
    --txt:#08113A; --lbl:#46506e;
    --card:#FFFFFF; --card2:#FDFDFD;
    --font:"Microsoft YaHei","微软雅黑",-apple-system,"Segoe UI",sans-serif;
    --num:"Segoe UI",Tahoma,Arial,sans-serif;
  }
  html,body{height:100%}
  body{background:var(--gray);font-family:var(--font);font-size:13px;color:var(--txt);overflow:hidden;user-select:none;
    background-image:
      linear-gradient(rgba(8,17,58,.045) 1px,transparent 1px),
      linear-gradient(90deg,rgba(8,17,58,.045) 1px,transparent 1px);
    background-size:30px 30px;}
  .app{display:flex;flex-direction:column;height:100vh}
  .up{color:var(--red)} .down{color:var(--blue)} .red{color:var(--red)} .blue{color:var(--blue)}

  /* ============ TITLE BAR ============ */
  .titlebar{flex:0 0 auto;min-height:34px;display:flex;flex-wrap:nowrap;align-items:center;gap:8px;padding:3px 8px;overflow-x:auto;
    background:linear-gradient(#f4f8f9,#e6edef);border-bottom:1px solid #c0cace}
  .titlebar>*{flex:0 0 auto}                                   /* 各项不收缩, 保持自然宽度, 永不压扁重叠 */
  /* 顶栏永不显示横向滚动条(极窄时仍可触控板横滑); 综合盈亏条允许收缩裁切让位给功能按钮 */
  .titlebar{scrollbar-width:none}
  .titlebar::-webkit-scrollbar{display:none}
  .titlebar .netbar{flex:0 1 auto;min-width:0;overflow:hidden;flex-wrap:nowrap;max-height:28px}
  .titlebar .ico{width:20px;height:20px;border-radius:50%}
  .titlebar .title{font-weight:700;font-size:13px;color:#222;white-space:nowrap}
  .titlebar .expire{background:var(--yellow);color:#c62828;font-weight:700;padding:4px 9px;border-radius:2px;font-size:12.5px}
  .titlebar .btn{border:none;cursor:pointer;font-size:12.5px;font-weight:700;border-radius:3px;padding:5px 13px}
  .btn-green{background:linear-gradient(var(--teal),var(--teal-deep));color:#fff}
  .btn-white{background:#fff;border:1px solid #c2c7cc;color:#2c2c2c;display:flex;align-items:center;gap:4px}
  .titlebar .spacer{flex:1}
  .winbtns{display:flex;gap:0}
  .winbtns button{width:30px;height:24px;border:none;background:transparent;color:#444;font-size:13px;cursor:pointer;border-radius:3px}
  .winbtns button:hover{background:#dfe2e6}
  .winbtns .x:hover{background:#e53935;color:#fff}

  /* ============ STATUS BAR ============ */
  .statusbar{flex:0 0 34px;display:flex;align-items:center;
    background:linear-gradient(var(--bar1),var(--bar2));color:#fff;font-weight:700;font-size:13.5px}
  .statusbar .seg{padding:0 16px;height:100%;display:flex;align-items:center;border-right:1px solid rgba(255,255,255,.28)}
  .statusbar .seg:last-child{border-right:none;flex:1}

  /* ===== 支付方式切换 + 内购卡片(橙色明亮系) ===== */
  .pm-tab{flex:1;padding:8px;border:1px solid #2a3a4a;background:#141c26;color:#8a959b;border-radius:6px;cursor:pointer;font-size:12px}
  .pm-tab.on{background:#f39c12;border-color:#f39c12;color:#fff;font-weight:700}
  .iap-card{width:190px;border-radius:10px;padding:14px;background:linear-gradient(150deg,#ff9d2f,#f26d21);color:#fff;box-shadow:0 4px 14px rgba(242,109,33,.3);cursor:pointer;transition:transform .12s}
  .iap-card:hover{transform:translateY(-3px)}
  .iap-card .nm{font-weight:700;font-size:15px;color:#fff}
  .iap-card .ds{color:rgba(255,255,255,.85);font-size:11px;min-height:30px;margin:6px 0}
  .iap-card .pr{font-size:20px;font-weight:800;color:#fff}
  .iap-card .pr small{font-size:11px;font-weight:500;opacity:.85}
  .iap-card .buy{margin-top:10px;width:100%;padding:7px;border:none;border-radius:6px;background:#fff;color:#e2611c;font-weight:700;cursor:pointer}
  .iap-card .buy[disabled]{background:rgba(255,255,255,.35);color:#fff;cursor:default}
  /* ===== marquee (飞书镜像跑马灯) ===== */
  .marquee{flex:0 0 28px;display:flex;align-items:center;background:#f3f7f8;border-bottom:1px solid #d4dde0;overflow:hidden}
  .marquee.flash{animation:mqflash 1s steps(2,jump-none) infinite}
  @keyframes mqflash{0%{background:#fff1e0}100%{background:#ffd9a8}}
  .marquee .mq-label{flex:0 0 auto;display:flex;align-items:center;gap:5px;height:100%;padding:0 12px;
    background:linear-gradient(var(--teal),var(--teal-deep));color:#fff;font-size:12px;font-weight:700}
  .mq-track{flex:1;overflow:hidden;position:relative;height:100%}
  .mq-inner{position:absolute;white-space:nowrap;will-change:transform;display:flex;align-items:center;height:100%;
    animation:mqscroll 225s linear infinite;font-size:12.5px;font-family:var(--font)}
  .marquee:hover .mq-inner,.mq-inner.paused{animation-play-state:paused}
  @keyframes mqscroll{0%{transform:translateX(100%)}100%{transform:translateX(-100%)}}
  .mq-item{display:inline-flex;align-items:center;gap:5px;padding:0 26px;position:relative}
  .mq-item::after{content:"·";position:absolute;right:6px;color:#b9c4c8}
  .mq-item .lv{font-weight:700;padding:0 5px;border-radius:3px;font-size:10.5px}
  .mq-item .lv.info{background:rgba(8,17,58,.14);color:var(--teal-deep)}
  .mq-item .lv.warn{background:rgba(224,123,58,.16);color:#c2611f}
  .mq-item .lv.err{background:rgba(229,57,53,.14);color:var(--red)}
  .mq-item .tm{color:#8a959b;font-family:var(--num)}
  .mq-mute{flex:0 0 auto;width:30px;border:none;background:transparent;color:#7c8990;cursor:pointer;font-size:12px;height:100%}
  .mq-mute:hover{background:#e3eaec}

  /* ============ MAIN ============ */
  .main{flex:1;display:flex;flex-direction:column;min-height:0;padding:8px 6px 0}

  /* ---- top section ---- */
  .content{flex:1;display:flex;flex-direction:row;min-height:0;gap:14px}
  .leftcol{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;min-height:0}
  .top{display:flex;gap:0;align-items:flex-start;height:312px}
  .accounts{display:flex;gap:14px;flex:0 0 auto}
  .accard{width:262px;height:292px;background:#FDFDFD;border:1px solid var(--cardline);border-radius:7px;overflow:hidden}
  .accard .h{background:linear-gradient(var(--teal),var(--teal-deep));color:#fff;text-align:center;font-weight:700;
    padding:6px 0;font-size:13.5px;letter-spacing:1px;border-bottom:1px solid var(--teal-deep)}
  .accard .body{padding:9px 16px 12px}
  .accard .r{display:flex;align-items:center;padding:2px 0;line-height:1.55;font-size:13px}
  .accard .r .k{flex:0 0 78px;text-align:right;color:var(--lbl)}
  .accard .r .v{margin-left:8px;color:#111;font-family:var(--num)}
  .accard .r .tri{margin-left:auto;font-size:13px}
  .accard .h{position:relative}
  .recon-btn{position:absolute;right:6px;top:3px;width:22px;height:20px;border:none;border-radius:4px;
    background:rgba(255,255,255,.18);color:#fff;cursor:pointer;font-size:12px;line-height:1}
  .recon-btn:hover{background:rgba(255,255,255,.34)}
  /* 行情状态卡片(主/对冲 并排) */
  .mktcards{display:flex;gap:12px;flex:0 0 auto;margin-left:16px}
  .mkcard{width:188px;height:292px;background:#FDFDFD;border:1px solid var(--cardline);border-radius:8px;overflow:hidden}
  .mkcard .mh{background:linear-gradient(var(--teal),var(--teal-deep));color:#fff;text-align:center;font-weight:700;padding:7px 0;font-size:14.5px;letter-spacing:.5px}
  .mkcard .mh.hedge{background:linear-gradient(#e08a3a,#c8702a)}
  .mkcard .mbody{padding:6px 13px}
  .mkcard .mr{display:flex;justify-content:space-between;align-items:center;padding:3.5px 0;font-size:14px;border-bottom:1px dashed #e6e9ec}
  .mkcard .mr.sm{padding:2.5px 0;font-size:11.5px}
  .mkcard .mr.sm .v{font-size:12px}
  .mkcard .mr:last-child{border-bottom:none}
  .mkcard .mr .k{color:var(--lbl)}
  .mkcard .mr .v{font-family:var(--num);color:#111;font-weight:700;font-size:14.5px}
  body.dark .mkcard{background:#101a33;border-color:#243056}
  body.dark .mkcard .mr{border-color:#1a2747}
  body.dark .mkcard .mr .v{color:#eaf2f4}
  /* 点差走势图(中部, flex:1 吸收账户卡收起空位→订单簿固定) */
  /* 点差走势(UI 与主界面一致: 浅色卡片 + 青色描边, 占原走势位置, flex:1 吸收账户收起空位) */
  .spreadchart{flex:1 1 auto;min-width:160px;display:flex;flex-direction:column;gap:6px;margin:0 14px;height:292px;
    background:#FDFDFD;border:1px solid var(--cardline);border-radius:8px;padding:8px 10px;overflow:hidden}
  .sc-wrap{flex:1;min-height:0;position:relative}
  .sc-toolbar{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:10.5px;color:var(--lbl)}
  .sc-toolbar input{background:#fff;border:1px solid #b8c0c5;border-radius:4px;padding:3px 5px;font-size:10.5px;color:var(--txt);font-family:var(--num);outline:none}
  .sc-toolbar input:focus{border-color:var(--teal)}
  /* PC: sc-dates/sc-drow/sc-strow 透明化(display:contents), 保持原内联布局; 移动端另行竖排(见 mobile-mode) */
  .sc-dates,.sc-drow,.sc-strow{display:contents}
  .sc-seg{display:inline-flex;border:1px solid var(--cardline);border-radius:4px;overflow:hidden}
  .sc-seg button{background:#fff;border:none;border-right:1px solid var(--cardline);color:var(--lbl);padding:3px 9px;font-size:10px;cursor:pointer}
  .sc-seg button:last-child{border-right:none}
  .sc-seg button:hover{background:var(--teal-pale)}
  .sc-seg button.on[data-d="forward"]{background:#1aa86a;color:#fff;font-weight:600}
  .sc-seg button.on[data-d="reverse"]{background:#e0683a;color:#fff;font-weight:600}
  .sc-seg button.on[data-h]{background:linear-gradient(var(--teal),var(--teal-deep));color:#fff;font-weight:600}
  .sc-go{background:linear-gradient(var(--teal),var(--teal-deep));color:#fff;border:none;border-radius:4px;padding:3px 12px;font-size:10px;font-weight:700;cursor:pointer}
  .sc-go:hover{filter:brightness(1.08)}
  .sc-cnt{color:var(--lbl);font-size:10px}
  .sc-legend{display:flex;align-items:center;gap:5px;font-size:10px;color:var(--lbl);font-family:var(--num)}
  .sc-dot{width:12px;height:2px;display:inline-block;background:#1aa86a}
  .sc-stats{display:flex;align-items:center;gap:8px;font-size:10px;font-family:var(--num);flex-wrap:wrap;
    background:var(--teal-pale);border:1px solid var(--cardline);border-radius:4px;padding:4px 8px;color:var(--txt)}
  .sc-stats .sc-mut{color:var(--lbl)} .sc-stats .sc-st-avg{color:var(--teal-deep);font-weight:700}
  .sc-wrap canvas{width:100%;height:100%;display:block}
  .sc-tip{position:absolute;pointer-events:none;background:#fff;border:1px solid var(--cardline);border-radius:4px;
    padding:4px 7px;font-size:10px;font-family:var(--num);color:var(--txt);white-space:nowrap;z-index:5;box-shadow:0 4px 12px rgba(8,17,58,.15)}
  body.dark .spreadchart{background:#101a33;border-color:#243056}
  body.dark .sc-toolbar input{background:#0b1428;border-color:#243056;color:#dbe6ea}
  body.dark .sc-seg{border-color:#243056} body.dark .sc-seg button{background:#101a33;color:#8aa0a8;border-color:#243056}
  body.dark .sc-stats{background:#0b1428;border-color:#243056;color:#dbe6ea}
  body.dark .sc-tip{background:#101a33;border-color:#243056;color:#dbe6ea}
  /* 账户卡片整体收起(往左滑) + 左侧重开手柄 */
  .accounts{transition:width .28s ease,margin .28s ease,opacity .24s ease,transform .28s ease;overflow:hidden}
  .accounts.hidden{width:0!important;margin:0!important;opacity:0;transform:translateX(-20px)}
  .acc-reopen{flex:0 0 auto;align-self:flex-start;width:18px;height:60px;margin-right:4px;border:1px solid var(--cardline);
    background:linear-gradient(var(--teal),var(--teal-deep));color:#fff;border-radius:0 6px 6px 0;cursor:pointer;font-size:12px}
  .acc-reopen:hover{filter:brightness(1.1)}

  .midspace{flex:1}

  /* ---- K线图 (移植自 testgo 行情K线) ---- */
  .klinepanel{flex:1;margin:0 8px;min-width:0;display:flex}
  .kl-card{flex:1;display:flex;flex-direction:column;background:#FDFDFD;border:1px solid var(--cardline);border-radius:6px;overflow:hidden;min-width:0}
  .kl-h{display:flex;align-items:center;gap:14px;background:var(--teal-pale);border-bottom:1px solid var(--cardline);padding:5px 11px}
  .kl-sym{font-weight:700;color:var(--teal-deep);font-size:12.5px}
  .kl-sym em{font-style:normal;font-weight:400;color:var(--lbl);font-size:11px}
  .kl-tf{display:flex;gap:2px}
  .kl-tf b{font-weight:600;font-size:11px;color:var(--lbl);padding:2px 8px;border-radius:4px;cursor:pointer}
  .kl-tf b:hover{background:rgba(8,17,58,.12)}
  .kl-tf b.on{background:var(--teal);color:#fff}
  .kl-ohlc{margin-left:auto;font-family:var(--num);font-size:11px;color:var(--lbl)}
  .kl-ohlc b{font-weight:700;margin:0 2px}
  .kl-canvas{flex:1;width:100%;display:block}

  /* ---- order book ---- */
  .orderbook{flex:0 0 282px;background:#FDFDFD;border:1px solid var(--cardline);border-radius:4px;display:flex;flex-direction:column}
  /* PC 端: 显示坑位区 反向Ask/正向Bid 点差流(表头+滚动数据行)+ 下方下单按钮。
     行区 overflow 滚动、min-height:0 防撑开顶掉下单按钮; 移动端另有精简规则(见 body.mobile-mode)。 */
  .ob-head{display:flex}
  .ob-head .c{flex:1;text-align:center;padding:7px 0}
  .ob-head .c:first-child{border-right:1px solid var(--cardline)}
  .ob-rows{flex:1;overflow-y:auto;min-height:0}
  .ob-row{display:flex;border-bottom:1px solid #e6e9ec;font-family:var(--num);font-size:13px}
  .ob-row .c{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:3px 12px}
  .ob-row .c:first-child{border-right:1px solid #e6e9ec}
  .ob-row .c .t{font-size:11px}
  .ob-foot{display:flex;align-items:stretch;border-top:1px solid var(--cardline);height:34px}
  .ob-foot .b{flex:1;border:none;color:#fff;font-weight:700;font-size:13px;cursor:pointer}
  .ob-foot .b.long{background:var(--teal)} .ob-foot .b.short{background:#e07b3a}
  .ob-foot .spin{flex:0 0 56px;display:flex;align-items:center;border-left:1px solid var(--cardline);border-right:1px solid var(--cardline)}
  .ob-foot .spin input{width:34px;border:none;text-align:center;font-family:var(--num);font-size:14px;outline:none;background:transparent}
  .ob-foot .spin .ar{display:flex;flex-direction:column;font-size:8px;color:#666}
  .ob-foot .spin .ar span{cursor:pointer;line-height:1}

  /* ---- user panel ---- */
  .userpanel{flex:0 0 250px;margin-left:12px;background:#FDFDFD;border:1px solid var(--cardline);border-radius:4px}
  .up-head{display:flex;border-bottom:1px solid var(--cardline);font-weight:700;color:#333;padding:7px 0}
  .up-head .c{flex:1;text-align:center}
  .up-row{display:flex;border-bottom:1px solid #e6e9ec;font-family:var(--num);padding:9px 0}
  .up-row .c{flex:1;text-align:center}

  /* ---- order table ---- */
  .bottom{flex:1;display:flex;min-height:0;margin-top:8px}
  .tablecard{flex:1;background:#FDFDFD;border:1px solid var(--cardline);border-radius:4px;overflow:auto}
  table{width:100%;border-collapse:collapse;font-family:var(--num);font-size:13.5px}
  thead th{background:var(--teal-pale);color:var(--teal-deep);font-weight:700;font-family:var(--font);font-size:12.5px;
    padding:9px 8px;border-bottom:1px solid var(--cardline);white-space:nowrap}
  thead th .sub{font-weight:400}
  tbody td{padding:11px 8px;border-bottom:1px solid #e6e9ec;text-align:center;white-space:nowrap}
  tbody tr.wait{background:#eef1f4}
  tbody tr:hover{background:#eef6f8}
  tbody tr.wait:hover{background:#e6edf0}
  .tag{display:inline-block;border:1px solid var(--red);color:var(--red);font-size:11px;
    padding:0 4px;border-radius:2px;margin:0 5px;font-family:var(--font)}
  .pt{display:inline-flex;align-items:center;gap:2px}
  .closebtn{display:inline-block;vertical-align:middle;background:linear-gradient(var(--teal),var(--teal-deep));color:#fff;border:none;font-weight:700;font-size:14px;
    padding:9px 30px;min-width:260px;cursor:pointer;letter-spacing:2px;border-radius:4px}
  .closebtn:hover{filter:brightness(1.06)}
  /* 坑位行动作单元格: 组件整体右对齐(进/出 + 开仓/平仓按钮组靠最右) */
  #otable td.actcell{text-align:right;white-space:nowrap}
  #otable td.actcell .armwrap{margin-right:6px}
  .closebtn.full{min-width:340px}
  /* 逐坑开仓按钮组(空坑有规则): 两按钮合并加长, 宽=平仓按钮宽 */
  .slotopen{display:inline-flex;vertical-align:middle;min-width:340px;border-radius:4px;overflow:hidden}
  .slotopen .sob{flex:1;border:none;color:#fff;font-weight:700;font-size:13.5px;padding:11px 0;cursor:pointer;letter-spacing:2px}
  .slotopen .sob.long{background:var(--teal)} .slotopen .sob.short{background:#e07b3a}
  .slotopen .sob:hover{filter:brightness(1.07)}
  .slot-norule{display:inline-block;vertical-align:middle;min-width:340px;text-align:center;padding:11px 0;border:1px dashed #c3cbd2;border-radius:4px;color:#8a959b;font-size:12.5px;cursor:pointer;background:#f7f9fa}
  .slot-norule:hover{border-color:var(--teal);color:var(--teal)}
  td.slotno{cursor:pointer} td.slotno:hover{color:var(--teal)}
  /* 右键菜单本坑四项明细: 仅移动端显示(PC 隐藏) */
  .mobile-only{display:none}
  .waitbtn{background:#dfe3e7;color:#5a5a5a;font-size:13px;padding:11px 0;width:100%;text-align:center;border-radius:2px}
  .cellinput{width:62px;border:1px solid #b8c0c8;text-align:center;font-family:var(--num);font-size:13.5px;padding:3px;outline:none;background:#fff}
  .cellinput:focus{border-color:var(--blue)}
  .act-col{min-width:240px}

  .userpanel2{flex:0 0 250px;margin-left:8px;align-self:flex-start;background:#FDFDFD;border:1px solid var(--cardline);border-radius:4px;margin-top:78px}

    .up-head{display:flex;align-items:center}
  .exp-btn{flex:0 0 auto;margin-left:8px;margin-right:6px;cursor:pointer;white-space:nowrap;
    font-size:11px;color:var(--teal,#08113A);background:rgba(8,17,58,.12);border-radius:4px;padding:2px 8px}
  .exp-btn:hover{background:rgba(8,17,58,.22)}
  /* in-flow 扩展：面板变宽，相邻的 K线/订单表(flex:1) 自动缩小，整体往左让位 */
  .userpanel{transition:flex-basis .18s}
  .userpanel2{transition:flex-basis .18s}
  .userpanel.expanded{flex:0 0 720px}
  /* 配对面板表头: 标题独占一行(不换行/不被挤) + 列标在下一行(仅紧凑态显示) */
  .ph-head{display:flex;align-items:center;justify-content:space-between;padding:7px 8px;border-bottom:1px solid var(--cardline);font-weight:700;color:#333}
  .ph-title{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ph-collabels{display:flex;border-bottom:1px solid var(--cardline);color:var(--lbl);font-weight:700;font-size:12px}
  .ph-collabels span{flex:1;text-align:center;padding:5px 0}
  body.dark .ph-head,body.dark .ph-collabels{color:#a8bcc3;border-color:#243056}
  /* 配对面板 = 右列(两列 flex), 满高; 明细展开→加宽, 左列被推挤变窄(非浮层) */
  #panel-paired{flex:0 0 250px;align-self:stretch;display:flex;flex-direction:column;margin:0;
    transition:flex-basis .26s ease;background:#FDFDFD;border:1px solid var(--cardline);border-radius:4px;overflow:hidden}
  #panel-paired.paired-wide{flex:0 0 920px}
  #panel-paired.paired-wide .phc-col{display:none}   /* 展开后不显示 点差/配对盈亏 列头 */
  #panel-paired.paired-wide #paired-detail{display:flex!important}
  /* TAB 行复用了模态框 .tabs 的负边距→在面板里会左侧外露; 这里清零并加底边 */
  #panel-paired .tabs{margin:0;padding:0;background:transparent;border-bottom:1px solid var(--cardline)}
  #panel-paired .ph-tab{font-size:11px}
  #panel-paired .ph-tab th{padding:5px 6px}
  #panel-paired .ph-tab td{padding:4px 6px}
  #panel-paired .ph-filters{font-size:11.5px}
  #panel-paired .dsum{gap:14px;font-size:12px;flex-wrap:wrap}
  /* 红框内容居中: 筛选条/汇总/表格整体水平居中, 列内文本居中 */
  #panel-paired #paired-detail .ph-bar{margin-top:16px}   /* 搜索行整行下移, 离 TAB 分隔线远点 */
  #panel-paired #paired-detail .ph-filters{justify-content:center}
  #panel-paired #paired-detail .dsum{justify-content:center}
  #panel-paired #paired-detail .tabs{justify-content:center}
  #panel-paired #paired-detail .ph-tab{margin:0 auto}
  #panel-paired #paired-detail .ph-tab th,#panel-paired #paired-detail .ph-tab td{text-align:center}
  body.dark #panel-paired{background:#101a33;border-color:#243056}
  .userpanel2.expanded{flex:0 0 720px;margin-top:0;align-self:stretch}
  .panel-table{width:100%;border-collapse:collapse;font-family:var(--num,monospace);font-size:12px}
  .panel-table th{background:var(--teal-pale,#eef0f6);color:var(--teal-deep,#040E32);font-family:var(--font);
    font-weight:700;font-size:11px;padding:7px 8px;text-align:right;white-space:nowrap;position:sticky;top:0}
  .panel-table th:first-child,.panel-table td:first-child{text-align:center}
  .panel-table td{padding:6px 8px;text-align:right;border-bottom:1px solid #e6e9ec;white-space:nowrap}
  .panel-table tr:nth-child(even){background:#eef2f3}
  body.dark .panel-table th{background:#16224a;color:#5aa8e8}
  body.dark .panel-table td{border-color:#1a2747}
  body.dark .panel-table tr:nth-child(even){background:#0e1730}
  ::-webkit-scrollbar{width:14px;height:14px}
  ::-webkit-scrollbar-thumb{background:#c2c7cc;border:3px solid #FDFDFD;border-radius:7px}
  ::-webkit-scrollbar-track{background:#eceff1}

  /* ===== context menu ===== */
  .ctxmenu{position:fixed;z-index:200;min-width:184px;background:#fff;border:1px solid var(--cardline);
    border-radius:6px;box-shadow:0 8px 24px rgba(8,17,58,.18);padding:5px 0;display:none;font-size:13px}
  .ctxmenu .mi{display:flex;align-items:center;gap:9px;padding:8px 16px;cursor:pointer;color:var(--txt)}
  .ctxmenu .mi:hover{background:var(--teal-pale);color:var(--teal-deep)}
  .ctxmenu .mi .ic{width:16px;text-align:center;color:var(--teal)}
  .ctxmenu .mi.on .ic{color:var(--teal-deep)}
  .ctxmenu .sep{height:1px;background:var(--cardline);margin:5px 0}
  .ctxmenu .mi.danger:hover{background:#fdecec;color:var(--red)}
  .ctxmenu .slot-detail{padding:4px 16px 6px;font-size:11.5px;font-family:var(--num)}
  .ctxmenu .slot-detail .sd-row{display:flex;justify-content:space-between;gap:12px;padding:2px 0}
  .ctxmenu .slot-detail .sd-row .k{color:var(--lbl)}
  .ctxmenu .slot-detail .sd-row .v{color:var(--txt);font-weight:700}
  body.dark .ctxmenu .slot-detail .sd-row .v{color:#dbe6ea}

  /* ===== modal ===== */
  .mask{position:fixed;inset:0;z-index:500;background:rgba(14,30,36,.42);display:none;align-items:center;justify-content:center}
  .mask.show{display:flex}
  .dlg{background:#f5f8f9;border:1px solid var(--cardline);border-radius:8px;width:760px;max-width:94vw;
    max-height:90vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.3)}
  .dlg.wide{width:1000px}
  .dlg .dh{display:flex;align-items:center;background:linear-gradient(var(--teal),var(--teal-deep));color:#fff;padding:10px 16px;cursor:grab;touch-action:none;user-select:none}
  .dlg .dh:active{cursor:grabbing}
  .dlg .dh button,.dlg .dh .x{cursor:pointer}
  /* 坑位内联武装徽章(武装了才显示: 正/反/全=自动开仓方向 / 出=自动平仓 / 损=止损平仓; 点击=解除, 损点击=进模态) */
  .armchip{display:inline-flex;align-items:center;justify-content:center;min-width:30px;height:28px;padding:0 9px;margin-right:6px;border-radius:4px;border:1px solid var(--teal);background:#fff;color:var(--teal);font-size:12.5px;font-weight:600;cursor:pointer;user-select:none;line-height:1;vertical-align:middle;transition:background .1s,color .1s,opacity .1s}
  .armchip.on{background:var(--teal);border-color:var(--teal);color:#fff}
  .armchip.sl{background:#c0392b;border-color:#c0392b;color:#fff}
  .armchip:active{opacity:.75}
  .armwrap{display:inline-flex;gap:0;vertical-align:middle}
  /* 坑位行"操作中"进度渐变: 天蓝 #2E8BD6 从左到右扫过(进场/平仓, 手动点击+自动实时触发) */
  #otable tr.slot-busy, body.mobile-mode #otable tr.slot-busy{
    background-image:linear-gradient(90deg, rgba(46,139,214,0) 0%, rgba(46,139,214,.40) 50%, rgba(46,139,214,0) 100%)!important;
    background-repeat:no-repeat!important; background-size:45% 100%!important;
    animation:slotSweep 1.05s linear infinite}
  @keyframes slotSweep{ from{background-position:-45% 0} to{background-position:145% 0} }
  /* 操作中秒数(进度渐变之外的数字反馈): 天蓝药丸, 贴操作列 */
  .slot-timer{display:inline-block;min-width:26px;text-align:center;margin-right:5px;padding:1px 6px;border-radius:9px;background:#2E8BD6;color:#fff;font-size:11px;font-weight:700;font-family:var(--num);vertical-align:middle;box-shadow:0 1px 4px rgba(46,139,214,.4)}
  @media(max-width:820px){ .slot-timer{min-width:30px;font-size:12px;padding:2px 7px} }
  body.dark .armchip{background:transparent;border-color:var(--teal);color:#8fd0ff}
  body.dark .armchip.on{background:var(--teal);color:#fff}
  @media(max-width:820px){ .armchip{min-width:38px;height:34px;font-size:14px;margin-right:6px;border-radius:6px} }
  /* 主订单列: 订单号(天蓝)+手数(草绿) 字条放大加粗 */
  .ord-info{font-size:16px;font-weight:800;margin-left:5px;letter-spacing:.2px;font-family:var(--num)}
  .ord-tk{color:#2E8BD6}
  .ord-lot{color:#43a047;margin-left:4px}
  .dlg .dh b{font-size:14px;font-weight:700;letter-spacing:.5px}
  .dlg .dh .sp{flex:1}
  .dlg .dh .x{width:26px;height:24px;border:none;background:rgba(255,255,255,.15);color:#fff;border-radius:4px;cursor:pointer;font-size:13px}
  .dlg .dh .x:hover{background:rgba(255,255,255,.32)}
  .dlg .db{padding:14px 18px;overflow:auto}
  .dlg .df{display:flex;justify-content:flex-end;gap:10px;padding:11px 18px;border-top:1px solid var(--cardline);background:#eef2f3}
  .dlg .df button{border:none;border-radius:5px;padding:8px 22px;font-weight:700;font-size:13px;cursor:pointer}
  .btn-primary{background:linear-gradient(var(--teal),var(--teal-deep));color:#fff}
  .btn-primary:hover{filter:brightness(1.1)}
  .btn-ghost{background:#fff;border:1px solid var(--cardline)!important;color:var(--lbl)}
  .btn-ghost:hover{background:#e8edee}

  /* tabs */
  .tabs{display:flex;gap:0;border-bottom:1px solid var(--cardline);margin:-14px -18px 14px;padding:0 12px;background:#eef2f3}
  .tabs .tab{padding:10px 16px;cursor:pointer;font-size:13px;color:var(--lbl);border-bottom:2px solid transparent;margin-bottom:-1px}
  .tabs .tab:hover{color:var(--teal-deep)}
  .tabs .tab.active{color:var(--teal-deep);font-weight:700;border-bottom-color:var(--teal)}
  .tabpane{display:none} .tabpane.active{display:block}

  /* config form grid */
  .formgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:11px 18px}
  /* grid 项 min-width:auto 会被输入框内在宽度(~190px)撑爆列宽→弹框横向滚动; 强制可收缩+输入框填满格子 */
  .formgrid .fld{min-width:0}
  .formgrid .fld input,.formgrid .fld select{width:100%;box-sizing:border-box;min-width:0}
  #batch-mask .db{overflow-x:hidden}
  .fld{display:flex;flex-direction:column;gap:4px}
  .fld label{font-size:11px;color:var(--lbl)}
  .fld .note{font-size:9.5px;color:#9aa6ac;line-height:1.3;margin-top:1px}
  body.dark .fld .note{color:#5f7077}
  .fld input,.fld select{border:1px solid #b8c0c5;border-radius:4px;padding:6px 8px;font-size:13px;font-family:var(--num);outline:none;background:#fff}
  .fld input:focus,.fld select:focus{border-color:var(--teal)}
  .fld.row2{flex-direction:row;align-items:center;gap:6px}
  .fld.row2 input{flex:1;min-width:0}
  .grouptitle{grid-column:1/-1;font-size:12px;font-weight:700;color:var(--teal-deep);border-bottom:1px dashed var(--cardline);padding-bottom:5px;margin-top:6px}
  /* 对冲参数配置: 3 TAB 合并一页 + flex自动折行居中(字段挨排, 排满换行, 绝无空单元格) */
  #cfg-mask .dlg{width:860px;max-width:96vw}
  #cfg-mask .tabpane{display:block}
  #cfg-mask .tabpane+.tabpane{margin-top:1px}
  #cfg-mask .db{padding:8px 12px}
  #cfg-mask .formgrid{display:flex;flex-wrap:wrap;justify-content:center;align-items:flex-start;gap:6px 10px}
  #cfg-mask .fld{width:120px;gap:2px}
  #cfg-mask .fld .note{display:none}                    /* 说明文字→输入框/标签悬停提示, 省高度 */
  #cfg-mask .fld label{font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #cfg-mask .fld:not(.row2) input{width:100%;max-width:100%;padding:4px 6px;font-size:12px}
  #cfg-mask .fld select{width:100%;max-width:100%;padding:4px 4px;font-size:12px}
  #cfg-mask .grouptitle{flex:0 0 100%;width:100%;margin-top:2px;padding-bottom:2px;font-size:11px}
  #cfg-mask .fld.row2{width:288px;flex-direction:row;align-items:center;gap:5px}
  #cfg-mask .fld.row2 label{flex:0 0 auto;font-size:10px}
  #cfg-mask .fld.row2 input{width:auto;flex:1 1 0;min-width:0}
  #cfg-mask .switches{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 8px}
  #cfg-mask .switches .sw{width:186px;padding:5px 9px;font-size:11.5px}
  /* 坑位规则设置: 说明文字→悬停提示(隐藏灰字, 信息在 title) */
  #slot-mask .fld .note{display:none}
  /* 交易历史 3tab: 各自独立(非active隐藏, active纵向flex); 修内联display导致三tab堆叠 */
  #paired-detail .tabpane{display:none}
  #paired-detail .tabpane.active{display:flex;flex-direction:column;flex:1;min-height:0}
  /* 交易历史 3tab 分页条 */
  .ph-pager{text-align:center;padding:6px 0 2px;border-top:1px solid var(--cardline);flex:0 0 auto}
  .ph-pager button[disabled]{opacity:.4;cursor:not-allowed}
  body.dark .ph-pager{border-color:#243056}
  .switches{display:grid;grid-template-columns:repeat(3,1fr);gap:10px 18px}
  .sw{display:flex;align-items:center;justify-content:space-between;background:#fff;border:1px solid var(--cardline);border-radius:5px;padding:7px 11px;font-size:12.5px}
  .sw .t{color:var(--lbl)}
  /* toggle */
  .toggle{position:relative;width:38px;height:20px;border-radius:11px;background:#c6ced2;cursor:pointer;transition:.18s;flex:0 0 auto}
  .toggle.on{background:var(--teal)}
  .toggle::after{content:"";position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;transition:.18s}
  .toggle.on::after{left:20px}

  /* dialog tables */
  .dtable{width:100%;border-collapse:collapse;font-family:var(--num);font-size:12.5px}
  .dtable th{background:var(--teal-pale);color:var(--teal-deep);font-family:var(--font);font-weight:700;padding:8px 10px;text-align:right;border-bottom:1px solid var(--cardline);white-space:nowrap}
  .dtable th:first-child{text-align:center}
  .dtable td{padding:7px 10px;text-align:right;border-bottom:1px solid #e6e9ec;white-space:nowrap}
  .dtable td:first-child{text-align:center}
  .dtable tr:nth-child(even){background:#eef2f3}
  .dsum{display:flex;gap:22px;margin-bottom:10px;font-size:13px}
  .dsum .it b{color:var(--teal-deep)}
  .dsum .it .num{font-family:var(--num);font-weight:700;margin-left:4px}
  /* 配对历史 筛选条 + 富表 */
  .ph-bar{display:flex;flex-direction:column;gap:10px;margin-bottom:8px}
  .ph-filters{display:flex;align-items:center;gap:7px;flex-wrap:wrap;font-size:12.5px}
  .ph-filters label{color:var(--lbl)}
  .ph-filters input{border:1px solid #b8c0c5;border-radius:4px;padding:4px 6px;font-size:12px;font-family:var(--num)}
  .ph-q{border:1px solid var(--cardline);background:#fff;color:var(--teal-deep);border-radius:4px;padding:4px 10px;cursor:pointer;font-size:12px}
  .ph-q:hover{background:var(--teal-pale)}
  .ph-go{padding:5px 16px;border-radius:5px;font-weight:700;font-size:12.5px;cursor:pointer;border:none}
  .ph-tab{font-size:11.5px}
  .ph-tab th{padding:6px 7px}
  .ph-tab td{padding:5px 7px}
  body.dark .ph-filters input{background:#0b1428;border-color:#243056;color:#dbe6ea}
  body.dark .ph-q{background:#101a33;border-color:#243056;color:#5aa8e8}

  /* ===== LOGIN ===== */
  #login{position:fixed;inset:0;z-index:400;display:flex;align-items:center;justify-content:center;
    background:radial-gradient(circle at 50% 32%,#15224a 0%,#0a1330 52%,#060c22 100%)}
  #login::before{content:"";position:absolute;inset:0;opacity:.5;
    background-image:linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);
    background-size:34px 34px}
  #login .card{position:relative;width:372px;background:rgba(255,255,255,.96);border-radius:12px;
    padding:34px 34px 26px;box-shadow:0 24px 70px rgba(0,0,0,.4);text-align:center}
  #login img{width:104px;height:104px;border-radius:18px;margin-bottom:14px;object-fit:contain;
    background:rgba(255,255,255,.04);box-shadow:0 8px 26px rgba(8,17,58,.45)}
  #login h1{font-size:18px;letter-spacing:3px;color:var(--teal-deep);font-weight:700}
  #login .sub{font-size:11px;color:#7c8990;letter-spacing:2px;margin:4px 0 22px}
  #login .field{text-align:left;margin-bottom:13px}
  #login label{display:block;font-size:11px;color:#5a6970;margin-bottom:5px}
  #login .ip{display:flex;align-items:center;border:1px solid #c4ccd0;border-radius:6px;padding:0 10px;background:#fff}
  #login .ip:focus-within{border-color:var(--teal);box-shadow:0 0 0 3px rgba(8,17,58,.14)}
  #login .ip i{color:var(--teal);font-style:normal;margin-right:7px}
  #login input{flex:1;border:none;outline:none;padding:10px 0;font-size:14px;font-family:var(--num);background:transparent}
  #login .opts{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#6a777e;margin-bottom:16px}
  #login .opts label{display:flex;align-items:center;gap:5px;cursor:pointer}
  #login .go{width:100%;padding:11px;border:none;border-radius:6px;cursor:pointer;font-size:14px;font-weight:700;letter-spacing:3px;
    background:linear-gradient(var(--teal),var(--teal-deep));color:#fff}
  #login .go:hover{filter:brightness(1.1)}
  #login .foot{margin-top:16px;font-size:10.5px;color:#9aa6ac;letter-spacing:.5px}

  /* ===== RENEW ===== */
  .plans{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:6px}
  .plan{border:1.5px solid var(--cardline);border-radius:8px;padding:16px 12px;text-align:center;cursor:pointer;background:#fff;position:relative;transition:.15s}
  .plan:hover{border-color:var(--teal-soft)}
  .plan.sel{border-color:var(--teal);box-shadow:0 0 0 3px rgba(8,17,58,.13)}
  .plan .tag{position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:#e07b3a;color:#fff;font-size:10px;padding:2px 9px;border-radius:9px;white-space:nowrap}
  .plan .nm{font-size:13px;color:var(--lbl)}
  .plan .pr{font-family:var(--num);font-size:24px;font-weight:700;color:var(--teal-deep);margin:6px 0}
  .plan .pr small{font-size:12px;font-weight:400;color:#8a959b}
  .plan .save{font-size:11px;color:#e07b3a}
  .paybox{display:flex;gap:14px;align-items:center;margin-top:16px;padding:14px;border:1px solid var(--cardline);border-radius:8px;background:#fff}
  .paybox .qr{width:120px;height:120px;flex:0 0 120px;border-radius:8px;border:1px solid var(--cardline);
    background:repeating-conic-gradient(#08113A 0% 25%,#fff 0% 50%) 50%/14px 14px;position:relative}
  .paybox .qr::after{content:"TRC20";position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
    background:#fff;color:var(--teal-deep);font-size:10px;font-weight:700;padding:2px 5px;border-radius:3px;border:1px solid var(--cardline)}
  .paybox .pi{flex:1;font-size:13px}
  .paybox .pi .row{display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px dashed var(--cardline)}
  .paybox .pi .row:last-child{border:none}
  .paybox .pi .k{color:var(--lbl)} .paybox .pi .v{font-family:var(--num);font-weight:700;color:var(--teal-deep)}
  .addr{font-family:var(--num);font-size:11.5px;background:#eef2f3;border-radius:5px;padding:7px 9px;margin-top:10px;
    display:flex;align-items:center;justify-content:space-between;word-break:break-all;gap:8px}
  .addr button{flex:0 0 auto;border:1px solid var(--cardline);background:#fff;border-radius:4px;padding:3px 9px;cursor:pointer;font-size:11px;color:var(--teal-deep)}
  .amtwrap{display:flex;align-items:center;gap:8px;margin-top:14px}
  .amtwrap label{font-size:12px;color:var(--lbl)}
  .amtwrap input{width:120px;border:1px solid #b8c0c5;border-radius:5px;padding:7px 9px;font-family:var(--num);font-size:14px;outline:none}
  .amtwrap input:focus{border-color:var(--teal)}

  /* ===== theme button ===== */
  .btn-theme{border:1px solid #c2c7cc;background:#fff;color:#2c4047;font-size:12px;font-weight:700;
    border-radius:4px;padding:5px 11px;cursor:pointer;margin-right:6px}
  .btn-theme:hover{border-color:var(--teal)}
  /* 用户登录管理模块(主题按钮右侧) */
  .usermenu{position:relative;display:inline-block}
  .um-btn{display:flex;align-items:center;gap:6px;border:1px solid #c2c7cc;background:#fff;color:#2c4047;font-size:12px;font-weight:700;border-radius:5px;padding:5px 9px;cursor:pointer;height:28px}
  .um-btn:hover{border-color:var(--teal)}
  .um-ava{width:18px;height:18px;border-radius:50%;background:linear-gradient(var(--teal),var(--teal-deep));color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px}
  .um-name{max-width:90px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .um-caret{font-size:9px;color:#8a959b}
  .um-pop{position:fixed;right:8px;top:38px;width:264px;max-height:calc(100vh - 60px);overflow-y:auto;background:#fff;border:1px solid var(--cardline);border-radius:10px;box-shadow:0 10px 30px rgba(8,17,58,.2);padding:12px;display:none;z-index:600}
  /* 身份头部: 大头像 + 昵称/账户 */
  .um-hd{display:flex;align-items:center;gap:10px;padding:2px 2px 4px}
  .um-hd-ava{flex:0 0 auto;width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#08113A,#2E8BD6);
    color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;text-transform:uppercase;box-shadow:0 2px 8px rgba(46,139,214,.35)}
