  const dark=document.body.classList.contains('dark');
  const upC=dark?'#ff5b6e':'#e53935', dnC=dark?'#54a8ff':'#2962ff';
  const grid=dark?'rgba(8,17,58,.10)':'rgba(8,17,58,.10)';
