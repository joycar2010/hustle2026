    body.mobile-mode .sc-toolbar input#sc-interval{width:44px;flex:0 0 auto}
    /* 一①: 开始/结束 竖排, 结束在开始下一行、日期左对齐(label 定宽让输入框左边缘对齐) */
    body.mobile-mode .sc-dates{display:flex;flex-direction:column;gap:4px;flex:1 1 100%}
    body.mobile-mode .sc-drow{display:flex;align-items:center;gap:6px}
