    body.mobile-mode .sc-drow input{flex:1 1 auto}
    body.mobile-mode #sc-dir{flex-direction:row}        /* 正向/反向 移动端横排 */
    body.mobile-mode #sc-dir button{flex:0 0 auto;padding:4px 12px;font-size:11px}
    /* 一②: 区间统计竖排两行, 第二行(正向 高/低/均)与"可视区间"左对齐 */
    body.mobile-mode .sc-stats{flex-direction:column;align-items:flex-start;gap:3px}
    body.mobile-mode .sc-strow{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    body.mobile-mode .sc-strow .sc-pipe{display:none}    /* 换行后首个竖线分隔符多余 */
