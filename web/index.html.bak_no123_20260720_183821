      +'<div class="k"><div class="kl">达标可套利</div><div class="kv '+vClass+'">'+(s.reachable||0)+'<span class="u">对</span></div></div>'
      +'<div class="k"><div class="kl">最高达标度</div><div class="kv">'+(s.top_score||0)+'<span class="u">/100</span></div></div>';
    // 隔夜利息(swap)行: 净利息+锁法方向; 负卡=每夜倒扣告警(点差大但过夜费吃利润)
    const swapRow=function(p){
      if(p.swap_net==null){ return '<div class="arb-swap na"><span class="sw-k">隔夜利息</span><span class="sw-v">— 数据不足</span></div>'; }
      const ok=p.swap_ok, sign=p.swap_net>0?'+':'';
