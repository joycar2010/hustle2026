      const sc=Math.max(0,Math.min(100,p.score||0));
      const cls = sc>=100?'s-ok':(sc>=80?'s-near':'s-low');
      const col = sc>=100?'#16a34a':(sc>=80?'#e6a23c':'#c0c8d6');
      const chip = sc>=100?'<span class="arb-chip ok">可套利</span>':(sc>=80?'<span class="arb-chip near">接近达标</span>':'<span class="arb-chip low">监控中</span>');
      const ring='<div class="arb-ring" style="background:conic-gradient('+col+' '+(sc*3.6)+'deg,#eef1f7 0)">'
        +'<div style="width:50px;height:50px;border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center">'
        +'<span class="rv" style="color:'+col+'">'+sc+'</span><span class="ru">/100</span></div></div>';
      const bar='<div class="arb-bar"><div class="fill" style="width:'+sc+'%;background:'+col+'"></div><div class="thr" style="left:100%"></div></div>';
      const mp=(p.main_price!=null?p.main_price:'—'), hp=(p.hedge_price!=null?p.hedge_price:'—'), bs=(p.basis!=null?p.basis:'—');
      return '<div class="arb-card '+cls+(radar?' radar':'')+'">'
        +'<div>'
          +'<div class="sym">'+p.main_symbol+'<span class="swap">'+SVGI('i-swap-h')+'</span>'+p.hedge_symbol+'</div>'
          +'<div class="arb-legs">'
            +'<span class="arb-leg"><span class="arb-dot '+(p.main_ok?'on':'off')+'"></span>主 '+mp+'</span>'
            +'<span class="arb-leg"><span class="arb-dot '+(p.hedge_ok?'on':'off')+'"></span>对冲 '+hp+'</span>'
            +(p.fluctuation_band?('<span class="arb-leg">波动带 '+p.fluctuation_band+'</span>'):'')+'</div>'
          +'<div class="arb-basis"><div class="bt"><span>当前基差 <b>'+bs+'</b></span><span>入场阈值 <b>'+p.entry_spread+'</b></span></div>'+bar+'</div>'
          +swapRow(p)
        +'</div>'
        +'<div class="arb-score">'+ring+chip+'</div>'
        +'<div class="arb-suggest">'+(p.suggest||'')+'</div>'
      +'</div>';
    };
    const cfg=pairs.filter(p=>p.configured), radar=pairs.filter(p=>!p.configured);
    $('arb-cfg-cnt').textContent='('+cfg.length+' 对)';
