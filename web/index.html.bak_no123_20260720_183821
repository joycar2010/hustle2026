  if(!await uiConfirm('启动循环下单','将每 <b>'+interval+'</b> 秒'+(waitOn?'':'(进单等待已关,不按间隔)')+'重复一次【'+dirCN+'】开仓，最多 <b>'+maxN+'</b> 单，可随时点停。\n\n这是真金自动化操作。')) return;
  __loopCount=0; __loopDir=direction; renderOpenBtns();
  const tick=async function(){
    if(!__loopDir) return;   // 已被停止
    if(__loopCount>=maxN){ stopLoop(); toast('循环下单达上限 '+maxN+' 单，已停'); return; }
    __loopCount++; renderOpenBtns();
    try{
      const j=await licPost('/cmd/open_pair',{username:QH.user,license_key:QH.key,confirm:true,direction:direction,symbol:(window.QHSYM||'XAUUSD'),slots:Math.max(1,Math.round(parseFloat(($('ob-qty')||{}).value)||1))});
      pushAlert('info','循环['+dirCN+'] 第'+__loopCount+'单 '+(j.msg||''));
    }catch(e){ pushAlert('err','循环第'+__loopCount+'单失败：'+(e.message||e)); stopLoop(); toast('循环下单遇错已停'); return; }
    if(__loopDir) __loopTimer=setTimeout(tick, interval*1000);
  };
  tick();
}

