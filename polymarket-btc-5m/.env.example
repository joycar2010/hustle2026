# === Wallet / CLOB (required only for --live) ===
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=3
CHAIN_ID=137
API_KEY=
API_SECRET=
API_PASSPHRASE=

# === Endpoints ===
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
POLYGON_RPC=https://polygon-rpc.com

# === Market ===
SERIES_SLUG=btc-up-or-down-5m

# === Strategy: late-window edge scalp ===
# Enter when t_remaining is in [MIN_T_REMAINING, ENTRY_WINDOW_SEC]
ENTRY_WINDOW_SEC=60
MIN_T_REMAINING_SEC=12
MIN_ENTRY_PRICE=0.75
MAX_ENTRY_PRICE=0.95
MIN_NET_EDGE=0.02
TAKER_FEE_RATE=0.07
CONFIRM_CHECKS=2
POLL_INTERVAL_SEC=1.0

# === BTC spot delta filter (vs window-open price) ===
DELTA_FILTER_ENABLED=true
UP_MIN_DELTA_USD=15
DOWN_MAX_DELTA_USD=-15
PRICE_HOSTS=okx,coinbase,kraken

# === Risk ===
ORDER_SHARES=10
MAX_ORDER_USD=15
DAILY_LOSS_LIMIT_USD=40
MAX_OPEN_POSITIONS=1
PAPER_BANKROLL_USD=200

# === Live kill switch (must be true AND pass --live) ===
LIVE_TRADING_ENABLED=false
