# === Wallet / CLOB (required only for --live late_edge) ===
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=3
CHAIN_ID=137
API_KEY=
API_SECRET=
API_PASSPHRASE=

# === Endpoints ===
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
POLYGON_RPC=https://polygon-rpc.com

# === Market / product (P7/P8; default keeps BTC 5m) ===
SERIES_SLUG=btc-up-or-down-5m
# Alternatives:
#   eth5m / sol5m              → late_edge A (separate paper_* ledgers)
#   btc-up-or-down-15m         → split_sell C
#   atp | counter-strike       → sports_mm
#   nba | nfl | dota | soccer_unl → sports_mm (OddsAPI when key set)
# WINDOW_SEC / MARKET_SLUG_PREFIX / *_DB_NAME are set by product profile
# when SERIES_SLUG is applied; leave unset for BTC 5m defaults.
# CRYPTO_ASSET=btc              # overridden by eth5m/sol5m profiles
# LATE_EDGE_DB_NAME=paper.db

# === P7.1 / P8 sports MM + Odds API ===
# SPORTS_DAILY_LOSS_LIMIT_USD=25
# SPORTS_PRE_GAME_OPEN_SEC=21600
# SPORTS_MIN_EDGE=0.04
# SPORTS_QUOTE_ON_MOCK=0          # keep 0; real key disables mock fallthrough
# SPORTS_DISCOVER_LIMIT=60
# ODDS_API_KEY=                   # The Odds API — never commit real keys
# ODDS_SPORT_KEYS=                # optional override (comma-separated)

# === Mode: late_edge | maker | split_sell ===
MODE=split_sell

# === P0-A late_edge gates (fee-aware expectancy fix) ===
ENTRY_WINDOW_SEC=60
MIN_T_REMAINING_SEC=15
MIN_ENTRY_PRICE=0.75
# P0 A: keep entries in [0.75,0.79] — [0.80,0.85) live WR≪breakeven
MAX_ENTRY_PRICE=0.79
OPENING_GAP_MAX_ENTRY_PRICE=0.78
HIGH_ASK_THRESHOLD=0.80
LATE_EDGE_HARD_BAN_PRICE=0.90
LATE_EDGE_EDGE_SAFETY=1.5
MIN_NET_EDGE=0.08
MIN_NET_EDGE_HIGH=0.12
TAKER_FEE_RATE=0.07
CONFIRM_CHECKS=3
CONFIRM_CHECKS_HIGH=5
POLL_INTERVAL_SEC=1.0

# === P1 late_edge bucket calibration (P0 faster fuse) ===
BUCKET_CALIBRATION_ENABLED=true
BUCKET_LOOKBACK_SEC=604800
BUCKET_MIN_SAMPLES=5
BUCKET_WR_BUFFER=0.03

# === BTC multi-venue signal (median + consensus; P1 asymmetric Δ) ===
DELTA_FILTER_ENABLED=true
UP_MIN_DELTA_USD=20
DOWN_MAX_DELTA_USD=-30
PRICE_HOSTS=okx,coinbase,kraken
SIGNAL_REQUIRE_CONSENSUS=true
SIGNAL_MIN_VENUES=2

# === P3 lead-hold / TWAP / opening gap (+ P1/P2 asymmetric) ===
LEAD_TABLE_ENABLED=true
LEAD_EDGE_MARGIN=0.05
LEAD_EDGE_MARGIN_DOWN=0.07
LEAD_MIN_BP=2
UP_LEAD_MIN_BP=1.5
DOWN_LEAD_MIN_BP=3.0
OPENING_GAP_ENABLED=true
OPENING_GAP_WINDOW_SEC=60
OPENING_GAP_MIN_BP=5

# P2: size ∝ (1-ask)/(1-ref)
SIZE_SCALE_ENABLED=true
SIZE_SCALE_REF_ASK=0.75

# === P0/P1/P5b Maker bilateral MM (paper) ===
MAKER_PAIR_COST_MAX=0.96
MAKER_PAIR_PROFIT_MIN=0.03
MAKER_QUOTE_SHARES=10
MAKER_START_DELAY_SEC=15
MAKER_STOP_BEFORE_END_SEC=60
MAKER_TOUCH_FILL_SEC=12
MAKER_MAX_IMBALANCE_SHARES=10
MAKER_ALLOW_CROSSED_FILLS=false
MAKER_FLATTEN_RESIDUAL=true
MAKER_MIN_BID_PRICE=0.20
MAKER_PAIR_COMPLETE_SEC=20
MAKER_ZERO_FILL_KILL_SEC=90
MAKER_EARLY_FLATTEN=true

# === P4/P5a/P6 split-sell (paper mint → touch asks → residual flatten → merge) ===
SPLIT_SIZE=50
SPLIT_FAIR_EDGE=0.01
SPLIT_MAX_LEAN_SHARES=3
SPLIT_CLIP_SHARES=10
SPLIT_TOUCH_FILL_SEC=5
SPLIT_STOP_BEFORE_END_SEC=45
SPLIT_MERGE_BEFORE_END_SEC=15
SPLIT_REBATE_BPS=42
SPLIT_MIN_PAIR_ASK=1.01
SPLIT_MIN_ASK_PRICE=0.20
SPLIT_LEAN_ABORT_SEC=20
SPLIT_JOIN_TOUCH=true
SPLIT_CATCHUP_IMPROVE_TICKS=1
SPLIT_CATCHUP_MIN_ASK=0.15
SPLIT_CATCHUP_TOUCH_FILL_SEC=3
SPLIT_RESIDUAL_FLATTEN=true
SPLIT_RESIDUAL_SLA_SEC=20

# === P2 observability ===
HEARTBEAT_STALE_SEC=120

# === Risk ===
ORDER_SHARES=10
MAX_ORDER_USD=15
DAILY_LOSS_LIMIT_USD=40
MAX_OPEN_POSITIONS=1
PAPER_BANKROLL_USD=200

LIVE_TRADING_ENABLED=false
DASHBOARD_PORT=8088
