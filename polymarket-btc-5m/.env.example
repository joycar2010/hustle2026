# === Wallet / CLOB (required only for --live late_edge) ===
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=3
CHAIN_ID=137
API_KEY=
API_SECRET=
API_PASSPHRASE=

# === Endpoints ===
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
POLYGON_RPC=https://polygon-rpc.com

# === Market ===
SERIES_SLUG=btc-up-or-down-5m

# === Mode: late_edge | maker ===
MODE=maker

# === P0-A late_edge gates (fee-aware expectancy fix) ===
ENTRY_WINDOW_SEC=60
MIN_T_REMAINING_SEC=15
MIN_ENTRY_PRICE=0.75
MAX_ENTRY_PRICE=0.88
LATE_EDGE_HARD_BAN_PRICE=0.90
LATE_EDGE_EDGE_SAFETY=1.25
MIN_NET_EDGE=0.08
TAKER_FEE_RATE=0.07
CONFIRM_CHECKS=3
POLL_INTERVAL_SEC=1.0

# === P1 late_edge bucket calibration ===
BUCKET_CALIBRATION_ENABLED=true
BUCKET_LOOKBACK_SEC=604800
BUCKET_MIN_SAMPLES=8
BUCKET_WR_BUFFER=0.02

# === BTC multi-venue signal (median + consensus) ===
DELTA_FILTER_ENABLED=true
UP_MIN_DELTA_USD=25
DOWN_MAX_DELTA_USD=-25
PRICE_HOSTS=okx,coinbase,kraken
SIGNAL_REQUIRE_CONSENSUS=true
SIGNAL_MIN_VENUES=2

# === P0/P1 Maker bilateral MM (paper) ===
MAKER_PAIR_COST_MAX=0.97
MAKER_PAIR_PROFIT_MIN=0.02
MAKER_QUOTE_SHARES=10
MAKER_START_DELAY_SEC=15
MAKER_STOP_BEFORE_END_SEC=60
MAKER_TOUCH_FILL_SEC=12
MAKER_MAX_IMBALANCE_SHARES=10
MAKER_ALLOW_CROSSED_FILLS=false
MAKER_FLATTEN_RESIDUAL=true

# === P2 observability ===
HEARTBEAT_STALE_SEC=120

# === Risk ===
ORDER_SHARES=10
MAX_ORDER_USD=15
DAILY_LOSS_LIMIT_USD=40
MAX_OPEN_POSITIONS=1
PAPER_BANKROLL_USD=200

LIVE_TRADING_ENABLED=false
DASHBOARD_PORT=8088
