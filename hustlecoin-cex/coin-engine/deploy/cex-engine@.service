[Unit]
Description=Coin Engine (Shard %i, standalone tree - 分家二期)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/coin-engine
ExecStart=/home/ec2-user/coin-engine/venv/bin/python3 -m engine --shard-id=%i
Environment=CEX_REDIS_URL=redis://10.0.1.95:6379
Environment=CEX_DATABASE_URL=postgresql://postgres:***@10.0.1.18:5432/cex_trading
Environment=CEX_ENCRYPTION_KEY=***copy-from-old-unit***
Environment=PYTHONPATH=/home/ec2-user/coin-engine
Restart=always
RestartSec=10
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
