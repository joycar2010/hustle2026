[Unit]
Description=CEX Arbitrage Trading Engine
After=network.target postgresql.service cex-business.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/hustlecoin-cex/python-business
ExecStart=/usr/bin/python3 -m engine
Environment=CEX_REDIS_URL=redis://10.0.1.95:6379
Environment=PYTHONPATH=/home/ec2-user/hustlecoin-cex/python-business
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
