{
  "uid": "pg-replication",
  "title": "PostgreSQL 主从复制",
  "tags": ["postgres", "replication"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "主库 Exporter",
      "datasource": { "type": "prometheus", "uid": "prometheus-cex" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [ { "expr": "up{job=\"postgres_primary\"}", "legendFormat": "primary", "refId": "A", "instant": true } ],
      "fieldConfig": {
        "defaults": {
          "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "在线从库数（应为 2）",
      "datasource": { "type": "prometheus", "uid": "prometheus-cex" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "expr": "count(pg_replication_is_replica{job=\"postgres_replica\"} == 1) or vector(0)", "legendFormat": "replicas", "refId": "A", "instant": true } ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 2 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "type": "stat",
      "title": "复制延迟（当前，>10s 危险）",
      "datasource": { "type": "prometheus", "uid": "prometheus-cex" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "targets": [ { "expr": "pg_replication_lag_seconds{job=\"postgres_replica\"}", "legendFormat": "{{instance}}", "refId": "A", "instant": true } ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "type": "timeseries",
      "title": "复制延迟走势",
      "datasource": { "type": "prometheus", "uid": "prometheus-cex" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "targets": [ { "expr": "pg_replication_lag_seconds{job=\"postgres_replica\"}", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "drawStyle": "line" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "replica1" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] },
          { "matcher": { "id": "byName", "options": "replica2" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "事务提交速率 TPS（cex_trading）",
      "datasource": { "type": "prometheus", "uid": "prometheus-cex" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "targets": [ { "expr": "rate(pg_stat_database_xact_commit{datname=\"cex_trading\"}[5m])", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "drawStyle": "line" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "primary" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "replica1" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] },
          { "matcher": { "id": "byName", "options": "replica2" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "连接数（cex_trading）",
      "datasource": { "type": "prometheus", "uid": "prometheus-cex" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 14 },
      "targets": [ { "expr": "pg_stat_database_numbackends{datname=\"cex_trading\"}", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "drawStyle": "line" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "primary" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "replica1" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] },
          { "matcher": { "id": "byName", "options": "replica2" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "WAL 体积",
      "datasource": { "type": "prometheus", "uid": "prometheus-cex" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 14 },
      "targets": [ { "expr": "pg_wal_size_bytes", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "drawStyle": "line" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "primary" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "replica1" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] },
          { "matcher": { "id": "byName", "options": "replica2" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "数据库体积（cex_trading）",
      "datasource": { "type": "prometheus", "uid": "prometheus-cex" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 14 },
      "targets": [ { "expr": "pg_database_size_bytes{datname=\"cex_trading\"}", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "drawStyle": "line" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "primary" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "replica1" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] },
          { "matcher": { "id": "byName", "options": "replica2" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
